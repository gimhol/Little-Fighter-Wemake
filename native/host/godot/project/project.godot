; Godot 宿主的最小工程（DESIGN §G1 骨架）：主场景只有一个节点，类型是扩展注册的 `LfwGodot`。
; 跑法见 native/README.md「Godot 宿主」——`--headless --path native/host/godot/project -- …`。
config_version=5

[application]

config/name="LFW (Godot host)"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7")

[native_extensions]

paths=["res://lfw_godot.gdextension"]

[display]

; 逻辑视口就是数据里的 `dataset.screen_w × screen_h`（794×450）⇒ 窗口默认按它开，
; 1 世界单位 = 1 像素（`--window-scale 1` 时截图出来的 PNG 也就是 794×450，不需要再裁）。
; ⚠ 截图（`--screenshot`）必须**不加** `--headless`：headless 没有渲染，视口纹理是空的。
window/size/viewport_width=794
window/size/viewport_height=450
; ⚠ **stretch 关掉**（`disabled`；别改回 `canvas_items` + `aspect=keep`）：那一档下引擎把"画布"
; 整个压进内容区——**渲染目标本身就只等于内容区**（实测 1400×500 的窗口里视口纹理只有 882×500），
; 于是画到窗口右端的自绘顶栏会被切掉（用户实测报的 bug），`--screenshot` 也抓不到黑边。
; 改成 contain + 居中由**宿主自己做**（`lfw_godot_node.cpp` 的 `contain_transform()`）：同一份矩阵
; 管三件事 —— 绘制的缩放/偏移、`_input()` 里窗口像素 → 逻辑像素的换算、`contain_rect()` 交给
; `canvas_item_set_clip` 把游戏**裁**在内容矩形里；自绘顶栏那一层按**窗口像素**铺满整窗。
; 逻辑屏幕仍是 794×450（游戏一像素没变），而 `--screenshot` 抓的是整窗（黑边 + 条 + 画面）。
window/stretch/mode="disabled"

[rendering]

; 世界之外的底色（背景层没盖住时看到的就是它）。**必须是纯黑**：TS 那边画布外面就是页面黑底；
; 之前写的是 `Color(0.06, 0.07, 0.1, 1)`（#0F1219 的深蓝灰），在 1400×500 这种非 16:9 的窗口里
; 两侧留边、以及导演数据没给 `bg` 的空场，一眼就是"灰条"（用户报的"底色应该纯黑"）。
; 实测（截图像素探针）：改前边缘 #0F1219、改后 #000000。
environment/defaults/default_clear_color=Color(0, 0, 0, 1)

[debug]

; headless 验收要拿得到完整输出：Godot 的 print / 引擎报错都写一份到 user://
; （stdout 被重定向到文件时是全缓冲的，进程异常退出会丢最后一段）。
file_logging/enable_file_logging=true
file_logging/log_path="user://godot.log"
