    KK: "ⒶⒿⒹ",
    "tutorial.key_hints": [ "Ha még nem állítottad be a gombokat,", "kattints a jobb felső sarokban lévő fogaskerék gombra", " a gombok megtekintéséhez és beállításához." ],
    "tutorial.dialog_0": [ "Állj! Nem tűnsz helybelinek...", "Mielőtt minden elkezdődik, meg kell ismerkedned a játékkal.", "Különben a harcban nagyon rossz lesz a helyzet." ],
    "tutorial.dialog_1": [ "Nyomva tarthatod a 'Fel/Le/Balra/Jobbra' gombokat, ", "így 【Sétálhatsz】 egy adott irányba." ],
    "tutorial.dialog_2": [ "Jó! Következik a 【Védekezés】.", "Nyomd meg a Ⓓ gombot a 【Védekezéshez】. Próbáld ki.", "Általában a 【Védekezés】 ki tudja védeni az elölről jövő támadásokat." ],
    "tutorial.dialog_3": [ "Jó! Következik az 【Ugrás】.", "Nyomd meg a Ⓙ gombot az 【Ugráshoz】. Próbáld ki.", "Irányokkal kombinálva egy adott irányba is 【Ugorhatsz】." ],
    "tutorial.dialog_4": [ "Jó! Következik a 【Futás】.", "【Álló】 helyzetben kattints duplán a '⬅/➡' gombra a 【Futáshoz】.", "Ezután az 'ellentétes irány' megnyomásával megállhatsz.", "Próbáld ki." ],
    "tutorial.dialog_5": [ "Jó! Következik a 【Sprint】.", "【Futás】 közben nyomd meg a Ⓙ gombot egy 【Sprint】 végrehajtásához. Próbáld ki.", "", "(【Ugrás utáni földet érésnél】/【Gurulásnál】, ", "a '⬅/➡ + Ugrás' megnyomásával szintén 【Sprintelhetsz】)" ],
    "tutorial.dialog_6": [ "Jó! Következik a 【Kitérés】.", "【Futás】 közben nyomd meg a Ⓓ gombot a 【Kitéréshez】. Próbáld ki.", "", "(【Ugrás utáni földet érésnél】/【Gurulásnál】, ", "a Ⓓ megnyomásával szintén 【Kitérhetsz】)" ],
    "tutorial.dialog_7": [ "A vak kitérés és védekezés nem győzi le az ellenfelet. ", "Most különböző támadásokat fogsz megtanulni.", "Nyomd meg a Ⓐ gombot egy 【Ütéshez】." ],
    "tutorial.dialog_8": [ "Jó! Következik a 【Futó támadás】.", "【Futás】 közben nyomd meg a Ⓐ gombot a 【Futó támadáshoz】.", "(Kattints duplán a '⬅/➡' gombra a 【Futáshoz】)" ],
    "tutorial.dialog_9": [ "Jó! Következik az 【Ugró támadás】.", "【Ugrás】 közben nyomd meg a Ⓐ gombot az 【Ugró támadáshoz】.", "", "(Nyomd meg a Ⓙ gombot az 【Ugráshoz】)" ],
    "tutorial.dialog_10": [ "Jó! Következik a 【Sprint támadás】.", "【Sprint】 közben nyomd meg a Ⓐ gombot a 【Sprint támadáshoz】.", "", "(Kattints duplán a '⬅/➡' gombra a 【Futáshoz】, majd nyomd meg a Ⓙ gombot a 【Sprinthez】)" ],
    "tutorial.dialog_11": [ "Jó! De még a szakértők is alig tudják elkerülni a sérülést.", "Ezért most azt fogod megtanulni: 【Gurulás】.", "Amikor 【a levegőbe repülsz】, nyomd meg a Ⓙ gombot egy 【Gurulás】 végrehajtásához.", "", "Most az erőmet használva 【a levegőbe repítelek】. Próbálj meg 【Gurulni】." ],
    "tutorial.dialog_12": [ "Jó! Úgy tűnik, már ismered az alapokat!", "Viszont a 【Mozdulatok】 használatával ügyesebb lehetsz a harcban.", "", "Általában a 【Mozdulatok】 kioldása: Ⓓ + irány + Ⓙ/Ⓐ.", "Nagyon kevés 【Mozdulatnál】 a kioldás módja: Ⓓ + Ⓙ + Ⓐ.", "(A gombokat egyszerre vagy egymás után is nyomhatod.)" ],
    "tutorial.dialog_13": [ "Látom, nem vagy átlagos ember. \n", "Mutasd meg a 【Mozdulataidat】.\n", "( Kérlek nyomd meg: Ⓓ + ➡ + Ⓐ )" ],
    "tutorial.dialog_14": [ "Szóval ez a távoli támadásod! Mi mást tudsz?", "", "( Kérlek nyomd meg: Ⓓ + ➡ + Ⓙ )" ],
    "tutorial.dialog_15": [ "Nagyon erős oldalrúgás! Mi mást tudsz?", "", "( Kérlek nyomd meg: Ⓓ + ⬆ + Ⓐ )" ],
    "tutorial.dialog_16": [ "Nagyon jó... megtanultam a mozdulataidat...", "…………" ],
    "tutorial.dialog_17": [ "Az előtted lévő utat én veszem át. Halj meg!!" ],
