    KK: "ⒶⒿⒹ",
    "tutorial.key_hints": [ "キー設定をまだ行っていない場合は、", "右上の歯車ボタンをクリックして、", "キー設定を確認・変更してください。" ],
    "tutorial.dialog_0": [ "待て！どうやら君はここの出身ではないようだな…", "すべてが始まる前に、操作方法に慣れておくべきだ。", "そうしないと、戦いはかなり厳しいものになるぞ。" ],
    "tutorial.dialog_1": [ "'上/下/左/右'を押し続ければ、", "好きな方向へ【歩行】できるようになる。" ],
    "tutorial.dialog_2": [ "よし！次は【防御】だ。", "Ⓓを押すと【防御】できる。試してみよう。", "一般的に、【防御】は正面からの攻撃を防ぐことができる。" ],
    "tutorial.dialog_3": [ "よし！次は【ジャンプ】だ。", "Ⓙを押すと【ジャンプ】できる。試してみよう。", "方向キーと組み合わせれば、好きな方向へ【ジャンプ】できるぞ。" ],
    "tutorial.dialog_4": [ "よし！次は【走り】だ。", "【立ち状態】のとき、'⬅/➡'をダブルクリックすると【走り】始める。", "止めるときは'反対方向'を押せばいい。", "試してみよう。" ],
    "tutorial.dialog_5": [ "よし！次は【ダッシュ】だ。", "【走り】中にⒿを押すと【ダッシュ】できる。試してみよう。", "", "（【ジャンプ】/【受身】からの着地時に、", "'⬅/➡ + ジャンプ'を押しても【ダッシュ】できる）" ],
    "tutorial.dialog_6": [ "よし！次は【回避】だ。", "【走り】中にⒹを押すと【回避】できる。試してみよう。", "", "（【ジャンプ】/【受身】からの着地時に、", "Ⓓを押しても【回避】できる）" ],
    "tutorial.dialog_7": [ "ただひたすら回避や防御をしていても、相手を倒すことはできない。", "次に、さまざまな攻撃方法を学んでいこう。", "Ⓐを押すと【パンチ】を繰り出せる。" ],
    "tutorial.dialog_8": [ "よし！次は【走り攻撃】だ。", "【走り】中にⒶを押すと【走り攻撃】できる。", "（'⬅/➡'をダブルクリックすると【走り】になる）" ],
    "tutorial.dialog_9": [ "よし！次は【ジャンプ攻撃】だ。", "【ジャンプ】中にⒶを押すと【ジャンプ攻撃】できる。", "", "（Ⓙを押すと【ジャンプ】する）" ],
    "tutorial.dialog_10": [ "よし！次は【ダッシュ攻撃】だ。", "【ダッシュ】中にⒶを押すと【ダッシュ攻撃】できる。", "", "（'⬅/➡'をダブルクリックして【走り】、続けてⒿで【ダッシュ】する）" ],
    "tutorial.dialog_11": [ "よし！だが、たとえ熟練者でも、まったく傷を負わずに戦うのは難しい。", "そこで次に覚えるのは【受身】だ。", "【空中に打ち上げられた】ときはⒿを押すと【受身】できる。", "", "では、これから私の超能力で君を【空中に打ち上げる】。【受身】を試してみろ。" ],
    "tutorial.dialog_12": [ "よし！どうやら基本操作はもう身についているようだ！", "ただし、【必殺技】を使いこなせば、戦いをより有利に進められる。", "", "一般的に、【必殺技】はⒹ + ⬅/➡/⬆/⬇ + Ⓙ/Ⓐで出す。", "また、ごく一部の【必殺技】はⒹ + Ⓙ + Ⓐで出す。", "（同時に押しても、順番に押してもよい）" ],
    "tutorial.dialog_13": [ "どうやら君はただ者ではないようだ。\n", "その【必殺技】を見せてもらおう。\n", "（Ⓓ + ➡ + Ⓐ を押してください）" ],
    "tutorial.dialog_14": [ "なるほど、それが君の遠距離攻撃か！まだ何かあるか？", "", "（Ⓓ + ➡ + Ⓙ を押してください）" ],
    "tutorial.dialog_15": [ "強烈なサイドキックだ！まだ何かあるか？", "", "（Ⓓ + ⬆ + Ⓐ を押してください）" ],
    "tutorial.dialog_16": [ "ふむ…君の技はもうすべて覚えたぞ…", "…………" ],
    "tutorial.dialog_17": [ "この先の道は俺が代わりに行く。死ね！！" ],
