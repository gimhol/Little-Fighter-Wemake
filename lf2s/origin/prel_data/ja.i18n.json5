    old_ending_0_0: [ "おめでとう！ステージモードをクリアしました。", "さらに高い難易度にも挑戦してみましょう！", "", "                                   —— 『LF2 2.0a』より" ],
    old_ending_0_1: [ "おめでとう！ステージモードをクリアしました。", "隠しキャラクターを解放するには、", "キャラクター選択画面で「lf2.net」と入力しましょう！", "", "                                   —— 『LF2 2.0a』より" ],
    old_ending_1: [ "LF2への多大なるご支援、本当にありがとうございます。", "知っていますか？世界中で人気のゲームを作ることは、ずっと私たちの夢でした。", "そして今、どうやらその夢は叶ったようです！", "LF2がすべてのプレイヤーの心に刻まれることを願っています。10年後も、", "20年後も…みなさんがこのゲームを覚えていてくれることを願っています！", "", "                                   —— 『LF2 2.0a』より" ],
    old_ending_2: [ "LF2が完成したら、私たちはそれぞれの仕事に戻ります…", "Martiは自らのキャリアを築こうとし、", "Starskyはアメリカ（UCLA）で", "学業を続けます。同じ目標に向かって", "努力してくれる人に出会えたのは、本当に稀有な偶然でした。", "いつかまた、一緒に", "もっと素晴らしいゲームを作る機会がありますように！", "", "                                   —— 『LF2 2.0a』より" ],
    old_ending_3: [ "改めて、すべてのご支援に感謝します。LF2よ、永遠なれ！", "", "LF2 Design Team", "Sep 2002", "", "                                   —— 『LF2 2.0a』より" ],
    gim_ending_0: [ "小熊の『Little Fighter 2 Remaster』がSteamで配信中です！ぜひ応援してあげてください。", "", "「gim.ink」と入力すると、ゲームのデバッグウィンドウを開けます。", "", "およそ二十数年前のある日、", "数人が同じキーボードを囲んでLF2を遊んでいました。", "その後、オンラインで一緒にLF2を遊ぶことも覚えました。", "さらに後には「改造版」の存在を知りましたが、結局まともな作品は作れずじまいでした。", "とはいえ、それでも「プログラミング」にほんの少しだけ触れることができ、さらには自分の職業選びにも影響を与えました……" ],
    gim_ending_1: [ "私は改造の知識と少しのコードを使って、ほぼ元と同じゲームを再現しました。", "また、LF2オリジナルのリソースをLittle Fighter Wemakeで使えるリソースに変換するツールも実装しました。", "今後、このツールを使って優秀な改造版を“LF2改造版:WEMAKE”に変換するかもしれません。", "ただ、それは難しいかもしれません。オリジナルの内部ロジックの細部を理解しきれない部分があり、", "しかも改造版はさまざまな効果を実現するために、多くの小手先のテクニックに依存しているからです。" ],
    gim_ending_2: [ "……LF2を再実装するなんて、少し幼稚なのかもしれません。「これは意味があるのか？」と自問しました。", "意味はあまりないかもしれません…それでも面白い。少なくとも退屈な人生のかなりの時間を楽しませてくれました。", "その本質は、現代人がスマホの画面をスワイプしてショート動画を流し続けるのと、何も変わらないのかもしれません。" ],
    gim_ending_3: [ "このゲームはかつて「世界中で流行したゲーム」でした！しかし、こうしたジャンルのゲームが、かつてのような盛り上がりを取り戻すのは難しいでしょう。", "この数行の言葉も、おそらく誰の目にも触れることはないでしょう。幼稚な中年男の独り言だと思ってください。", "", "Gim 2025年9月" ],
    demo_cam_ctrl: "ジャンプ + ←→：注目ファイターを切り替え。↑↓←→：カメラを操作。攻撃：デモを切り替え。ジャンプ：カメラを解放。防御：注目を解除",
    curr_focus: "現在の注目：",
    cam_controlling: "カメラ操作中",
