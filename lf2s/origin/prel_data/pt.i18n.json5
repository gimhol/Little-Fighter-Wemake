    KK: "ⒶⒿⒹ",
    "tutorial.key_hints": [ "Se ainda não configuraste os comandos,", "clica no botão de engrenagem no canto superior direito", " para veres e configurares os comandos." ],
    "tutorial.dialog_0": [ "Pára! Não pareces ser daqui...", "Antes de tudo começar, devias familiarizar-te com a forma de jogar.", "Caso contrário, a situação na batalha vai ser mesmo má." ],
    "tutorial.dialog_1": [ "Podes manter pressionado 'Cima/Baixo/Esquerda/Direita' ", "e conseguirás 【Caminhar】 numa direção específica." ],
    "tutorial.dialog_2": [ "Muito bem! A seguir: a 【Defesa】.", "Pressiona Ⓓ para 【Defender】. Experimenta.", "Em geral, a 【Defesa】 bloqueia ataques vindos da frente." ],
    "tutorial.dialog_3": [ "Muito bem! A seguir: o 【Salto】.", "Pressiona Ⓙ para 【Saltar】. Experimenta.", "Também podes combinar com uma direção para 【Saltar】 numa direção específica." ],
    "tutorial.dialog_4": [ "Muito bem! A seguir: a 【Corrida】.", "Quando estiveres 【em pé】, clica duas vezes em '⬅/➡' para 【Correr】.", "Depois, podes pressionar a 'direção oposta' para parares.", "Experimenta." ],
    "tutorial.dialog_5": [ "Muito bem! A seguir: o 【Salto de corrida】.", "Em 【Corrida】, pressiona Ⓙ para fazeres um 【Salto de corrida】. Experimenta.", "", "(【Ao aterrar de um salto】/【Rolamento】, ", "pressionar '⬅/➡ + Salto' também permite fazer um 【Salto de corrida】)" ],
    "tutorial.dialog_6": [ "Muito bem! A seguir: a 【Esquiva】.", "Em 【Corrida】, pressiona Ⓓ para 【Esquivar】. Experimenta.", "", "(【Ao aterrar de um salto】/【Rolamento】, ", "pressionar Ⓓ também permite fazer uma 【Esquiva】)" ],
    "tutorial.dialog_7": [ "Esquivar e defender às cegas não vai derrotar o teu adversário. ", "A seguir, vais aprender vários métodos de ataque.", "Pressiona Ⓐ para fazeres um 【Soco】." ],
    "tutorial.dialog_8": [ "Muito bem! A seguir: o 【Ataque em corrida】.", "Em 【Corrida】, pressiona Ⓐ para fazeres um 【Ataque em corrida】.", "(Clica duas vezes em '⬅/➡' para 【Correr】)" ],
    "tutorial.dialog_9": [ "Muito bem! A seguir: o 【Ataque em salto】.", "Em 【Salto】, pressiona Ⓐ para fazeres um 【Ataque em salto】.", "", "(Pressiona Ⓙ para 【Saltar】)" ],
    "tutorial.dialog_10": [ "Muito bem! A seguir: o 【Ataque em salto de corrida】.", "Em 【Salto de corrida】, pressiona Ⓐ para fazeres um 【Ataque em salto de corrida】.", "", "(Clica duas vezes em '⬅/➡' para 【Correr】 e, depois, pressiona Ⓙ para fazeres um 【Salto de corrida】)" ],
    "tutorial.dialog_11": [ "Muito bem! Mas até os especialistas dificilmente conseguem evitar ficar feridos.", "Por isso, o que vais aprender a seguir é: o 【Rolamento】.", "Quando fores 【projetado para o ar】, pressiona Ⓙ para fazeres um 【Rolamento】.", "", "A seguir, vou usar o meu poder para 【te projetar para o ar】. Tenta fazer um 【Rolamento】." ],
    "tutorial.dialog_12": [ "Muito bem! Parece que já conheces algumas operações básicas!", "No entanto, usar 【Golpes especiais】 vai tornar-te mais proficiente nas batalhas.", "", "Em geral, a forma de lançar um 【Golpe especial】 é: Ⓓ + ⬅/➡/⬆/⬇ + Ⓙ/Ⓐ.", "Além disso, para muito poucos 【Golpes especiais】, o comando é: Ⓓ + Ⓙ + Ⓐ.", "(Podes pressioná-las ao mesmo tempo ou uma a uma.)" ],
    "tutorial.dialog_13": [ "Consigo perceber que não és uma pessoa comum. \n", "Mostra-me o teu 【Golpe especial】.\n", "( Pressiona Ⓓ + ➡ + Ⓐ )" ],
    "tutorial.dialog_14": [ "Então é esta a tua forma de ataque à distância! E que mais?", "", "( Pressiona Ⓓ + ➡ + Ⓙ )" ],
    "tutorial.dialog_15": [ "Um pontapé lateral muito forte! E que mais?", "", "( Pressiona Ⓓ + ⬆ + Ⓐ )" ],
    "tutorial.dialog_16": [ "Muito bem... já aprendi os teus golpes...", "…………" ],
    "tutorial.dialog_17": [ "Vou tomar conta do caminho à tua frente. MORRE!!" ],
