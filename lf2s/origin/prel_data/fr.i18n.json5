    KK: "ⒶⒿⒹ",
    "tutorial.key_hints": [ "Si tu n'as pas encore configuré les touches,", "clique sur le bouton en forme d'engrenage en haut à droite", " pour consulter et régler les touches." ],
    "tutorial.dialog_0": [ "Stop ! Tu n'as pas l'air d'être d'ici...", "Avant que tout ne commence, tu devrais apprendre à jouer.", "Sinon, la situation au combat risque d'être vraiment mauvaise." ],
    "tutorial.dialog_1": [ "Tu peux maintenir 'Haut/Bas/Gauche/Droite' ", "et tu pourras 【Marcher】 dans une direction précise." ],
    "tutorial.dialog_2": [ "Bien ! Ensuite : la 【Défense】.", "Appuie sur Ⓓ pour 【Défendre】. Essaie.", "En général, la 【Défense】 peut bloquer les attaques venues de face." ],
    "tutorial.dialog_3": [ "Bien ! Ensuite : le 【Saut】.", "Appuie sur Ⓙ pour 【Sauter】. Essaie.", "Tu peux aussi combiner avec une direction pour 【Sauter】 dans une direction précise." ],
    "tutorial.dialog_4": [ "Bien ! Ensuite : la 【Course】.", "En 【position debout】, double-clique sur '⬅/➡' pour 【Courir】.", "Puis appuie sur la 'direction opposée' pour t'arrêter.", "Essaie." ],
    "tutorial.dialog_5": [ "Bien ! Ensuite : le 【Saut de course】.", "En 【Course】, appuie sur Ⓙ pour faire un 【Saut de course】. Essaie.", "", "(En 【atterrissant d'un saut】/【Réception roulée】, ", "appuyer sur '⬅/➡ + Saut' permet aussi de faire un 【Saut de course】)" ],
    "tutorial.dialog_6": [ "Bien ! Ensuite : l'【Esquive】.", "En 【Course】, appuie sur Ⓓ pour 【Esquiver】. Essaie.", "", "(En 【atterrissant d'un saut】/【Réception roulée】, ", "appuyer sur Ⓓ permet aussi de faire une 【Esquive】)" ],
    "tutorial.dialog_7": [ "Esquiver et défendre sans réfléchir ne vaincra pas ton adversaire. ", "Tu vas maintenant apprendre différentes attaques.", "Appuie sur Ⓐ pour faire un 【Coup de poing】." ],
    "tutorial.dialog_8": [ "Bien ! Ensuite : l'【Attaque en course】.", "En 【Course】, appuie sur Ⓐ pour faire une 【Attaque en course】.", "(Double-clique sur '⬅/➡' pour 【Courir】)" ],
    "tutorial.dialog_9": [ "Bien ! Ensuite : l'【Attaque sautée】.", "En 【Saut】, appuie sur Ⓐ pour faire une 【Attaque sautée】.", "", "(Appuie sur Ⓙ pour 【Sauter】)" ],
    "tutorial.dialog_10": [ "Bien ! Ensuite : l'【Attaque en saut de course】.", "En 【Saut de course】, appuie sur Ⓐ pour faire une 【Attaque en saut de course】.", "", "(Double-clique sur '⬅/➡' pour 【Courir】, puis appuie sur Ⓙ pour 【Sauter en courant】)" ],
    "tutorial.dialog_11": [ "Bien ! Mais même les experts ont du mal à ne jamais être blessés.", "Tu vas donc apprendre : la 【Réception roulée】.", "Quand tu es 【projeté en l'air】, appuie sur Ⓙ pour faire une 【Réception roulée】.", "", "Je vais maintenant utiliser mon pouvoir pour 【te projeter en l'air】. Essaie de faire une 【Réception roulée】." ],
    "tutorial.dialog_12": [ "Bien ! On dirait que tu maîtrises déjà les bases !", "Cependant, utiliser des 【Coups spéciaux】 te rendra plus redoutable au combat.", "", "En général, la façon de lancer un 【Coup spécial】 est : Ⓓ + direction + Ⓙ/Ⓐ.", "De plus, pour de très rares 【Coups spéciaux】, la commande est : Ⓓ + Ⓙ + Ⓐ.", "(Tu peux appuyer sur les touches en même temps ou l'une après l'autre.)" ],
    "tutorial.dialog_13": [ "Je peux voir que tu n'es pas un homme ordinaire. \n", "Montre-moi ton 【Coup spécial】.\n", "( Appuie sur Ⓓ + ➡ + Ⓐ )" ],
    "tutorial.dialog_14": [ "C'est donc là ton attaque à distance ! Quoi d'autre ?", "", "( Appuie sur Ⓓ + ➡ + Ⓙ )" ],
    "tutorial.dialog_15": [ "Très puissant, ce coup de pied latéral ! Quoi d'autre ?", "", "( Appuie sur Ⓓ + ⬆ + Ⓐ )" ],
    "tutorial.dialog_16": [ "Très bien... j'ai appris tes techniques...", "…………" ],
    "tutorial.dialog_17": [ "Je vais prendre la route devant toi. Meurs !!" ],
