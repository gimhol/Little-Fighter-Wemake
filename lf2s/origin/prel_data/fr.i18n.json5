    old_ending_0_0: [ "Félicitations, tu as terminé le mode Histoire.", "Essaie de relever un défi plus élevé !", "", "                                   —— de « LF2 2.0a »" ],
    old_ending_0_1: [ "Félicitations, tu as terminé le mode Histoire.", "Pour débloquer les personnages secrets,", "tape simplement « lf2.net » à l'écran de sélection du personnage !", "", "                                   —— de « LF2 2.0a »" ],
    old_ending_1: [ "Merci beaucoup pour ton soutien à LF2.", "Le savais-tu ? Créer un jeu populaire dans le monde entier a toujours été notre rêve, ", "et il me semble qu'aujourd'hui, notre objectif est atteint !", "Nous espérons que LF2 restera gravé dans le cœur de chaque joueur ! Dans 10 ans,", "20 ans... nous espérons que vous vous souviendrez encore du jeu !", "", "                                   —— de « LF2 2.0a »" ],
    old_ending_2: [ "Une fois LF2 terminé, nous retournerons tous", "à nos occupations... Marti tentera de créer sa propre carrière,", "tandis que Starsky poursuivra ses études", "aux États-Unis (UCLA). C'est un hasard", "exceptionnel que de rencontrer quelqu'un qui lutte pour le même but.", "J'espère qu'un jour nous aurons l'occasion", "de retravailler ensemble, pour créer un jeu encore plus fantastique !", "", "                                   —— de « LF2 2.0a »" ],
    old_ending_3: [ "Merci encore pour tout votre soutien. Longue vie à LF2 !", "", "Équipe de conception de LF2", "Sep 2002", "", "                                   —— de « LF2 2.0a »" ],
    gim_ending_0: [ "« Little Fighter 2 Remaster » de Xiao Xiong est maintenant disponible sur Steam ! Vous pouvez le soutenir.", "", "Tapez gim.ink pour ouvrir la fenêtre de débogage du jeu.", "", "C'était il y a une vingtaine d'années,", "quelques personnes se serraient autour d'un même clavier pour jouer à LF2.", "Plus tard, j'ai appris à y jouer en ligne avec d'autres.", "Encore plus tard, j'ai découvert les « mods », mais sans jamais vraiment en créer un abouti.", "Quoi qu'il en soit, cela m'a tout de même rapproché de la « programmation », et a même influencé mon choix de carrière..." ],
    gim_ending_1: [ "Avec quelques connaissances en modding et du code, j'ai reconstitué un jeu à peu près fidèle.", "J'ai aussi écrit des outils pour convertir les ressources de LF2 original en ressources utilisables par Little Fighter Wemake.", "Peut-être qu'à l'avenir j'utiliserai ces outils pour convertir quelques bonnes modifications en « LF2 Remaster : WEMAKE ».", "Mais ce sera sans doute difficile, car certains détails de la logique interne de l'original m'échappent,", "et les mods reposent souvent sur de nombreux raccourcis pour réaliser divers effets." ],
    gim_ending_2: [ "...Réimplémenter un LF2, c'est peut-être un peu naïf. « Est-ce que cela a un sens ? » me suis-je demandé.", "Je pense que cela n'a pas beaucoup de sens... mais c'est intéressant, et cela a au moins occupé une bonne partie de ma vie ennuyeuse.", "En cela, c'est fondamentalement comme les gens d'aujourd'hui qui font défiler des vidéos courtes sur leur téléphone." ],
    gim_ending_3: [ "Ce jeu était autrefois « populaire dans le monde entier » ! Mais ce genre de jeu a du mal à retrouver sa gloire passée.", "Ces quelques mots ne seront probablement jamais lus par personne, comme les pensées murmurées d'un quadragénaire un peu naïf.", "", "Gim, septembre 2025" ],
    demo_cam_ctrl: "Saut + ←→ : Changer de combattant ciblé. ↑↓←→ : Contrôler la caméra. Attaque : Changer de démo. Saut : Libérer la caméra. Défense : Arrêter le ciblage",
    curr_focus: "cible actuelle :",
    cam_controlling: "Contrôle de la caméra",
