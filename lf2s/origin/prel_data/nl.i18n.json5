    KK: "ⒶⒿⒹ",
    "tutorial.key_hints": [ "Als je de toetsen nog niet hebt ingesteld,", "klik dan op het tandwielpictogram rechtsboven", " om de toetsen te bekijken en in te stellen." ],
    "tutorial.dialog_0": [ "Stop! Je lijkt hier niet vandaan te komen...", "Voordat alles begint, moet je vertrouwd raken met hoe je speelt.", "Anders ziet het er in de strijd echt slecht voor je uit." ],
    "tutorial.dialog_1": [ "Je kunt 'Omhoog/Omlaag/Links/Rechts' ingedrukt houden ", "en zo kun je in een specifieke richting 【Lopen】." ],
    "tutorial.dialog_2": [ "Goed! Nu: 【Verdediging】.", "Druk op Ⓓ om je te 【Verdedigen】. Probeer het.", "Over het algemeen kan 【Verdediging】 aanvallen van voren blokkeren." ],
    "tutorial.dialog_3": [ "Goed! Nu: 【Springen】.", "Druk op Ⓙ om te 【Springen】. Probeer het.", "Je kunt het ook combineren met een richting om in een specifieke richting te 【Springen】." ],
    "tutorial.dialog_4": [ "Goed! Nu: 【Rennen】.", "Dubbelklik in 【staande】 houding op '⬅/➡' om te beginnen met 【Rennen】.", "Druk daarna op de 'tegengestelde richting' om te stoppen met rennen.", "Probeer het." ],
    "tutorial.dialog_5": [ "Goed! Nu: 【Dash】.", "Tijdens het 【Rennen】 kun je op Ⓙ drukken voor een 【Dash】. Probeer het.", "", "(【Bij het landen van een sprong】/【Breakfall】, ", "kun je met '⬅/➡ + Springen' ook een 【Dash】 uitvoeren)" ],
    "tutorial.dialog_6": [ "Goed! Nu: 【Ontwijken】.", "Tijdens het 【Rennen】 kun je op Ⓓ drukken om te 【Ontwijken】. Probeer het.", "", "(【Bij het landen van een sprong】/【Breakfall】, ", "kun je met Ⓓ ook een 【Ontwijken】 uitvoeren)" ],
    "tutorial.dialog_7": [ "Blind ontwijken en verdedigen verslaat je tegenstander niet. ", "Nu leer je verschillende aanvalsmethoden.", "Druk op Ⓐ voor een 【Stoot】." ],
    "tutorial.dialog_8": [ "Goed! Nu: 【Aanval tijdens het rennen】.", "Tijdens het 【Rennen】 druk je op Ⓐ voor een 【Aanval tijdens het rennen】.", "(Dubbelklik op '⬅/➡' om te 【Rennen】)" ],
    "tutorial.dialog_9": [ "Goed! Nu: 【Sprongaanval】.", "Tijdens het 【Springen】 druk je op Ⓐ voor een 【Sprongaanval】.", "", "(Druk op Ⓙ om te 【Springen】)" ],
    "tutorial.dialog_10": [ "Goed! Nu: 【Dash-aanval】.", "Tijdens de 【Dash】 druk je op Ⓐ voor een 【Dash-aanval】.", "", "(Dubbelklik op '⬅/➡' om te 【Rennen】, druk daarna op Ⓙ om te 【Dash】)" ],
    "tutorial.dialog_11": [ "Goed! Maar zelfs experts kunnen niet voorkomen dat ze volledig geraakt worden.", "Wat je nu leert is: 【Breakfall】.", "Wanneer je 【de lucht in geslagen】 wordt, druk op Ⓙ voor een 【Breakfall】.", "", "Nu gebruik ik mijn superkracht om je 【de lucht in te slaan】. Probeer een 【Breakfall】." ],
    "tutorial.dialog_12": [ "Goed! Het lijkt erop dat je de basis al kent!", "Maar het gebruik van 【Bewegingen】 maakt je beter in gevechten.", "", "Over het algemeen voer je 【Bewegingen】 uit met: Ⓓ + ⬅/➡/⬆/⬇ + Ⓙ/Ⓐ.", "Voor een paar 【Bewegingen】 is de manier: Ⓓ + Ⓙ + Ⓐ.", "(Je kunt de toetsen tegelijk of na elkaar indrukken.)" ],
    "tutorial.dialog_13": [ "Ik zie dat je geen gewoon persoon bent. \n", "Laat me je 【Bewegingen】 zien.\n", "( Druk op Ⓓ + ➡ + Ⓐ )" ],
    "tutorial.dialog_14": [ "Dus dit is je aanvalsmethode van afstand! Wat nog meer?", "", "( Druk op Ⓓ + ➡ + Ⓙ )" ],
    "tutorial.dialog_15": [ "Zeer krachtige zijschop! Wat nog meer?", "", "( Druk op Ⓓ + ⬆ + Ⓐ )" ],
    "tutorial.dialog_16": [ "Heel goed... ik heb je bewegingen geleerd...", "…………" ],
    "tutorial.dialog_17": [ "Ik neem het pad voor je over. STERF!!" ],
