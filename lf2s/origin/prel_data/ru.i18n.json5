    disable: "Выключить",
    KK: "ⒶⒿⒹ",
    "tutorial.key_hints": [ "Если вы ещё не настроили клавиши управления,", "пожалуйста, нажмите на кнопку-шестерёнку в правом верхнем углу,", " чтобы просмотреть и настроить клавиши." ],
    "tutorial.dialog_0": [ "Стой! Похоже, ты не здешний...", "Прежде чем всё начнётся, тебе стоит освоиться и понять, как играть.", "Иначе в бою тебе придётся очень тяжело." ],
    "tutorial.dialog_1": [ "Ты можешь удерживать клавиши 'Вверх/Вниз/Влево/Вправо', ", "и тогда сможешь 【ходить】 в нужном направлении." ],
    "tutorial.dialog_2": [ "Хорошо! Теперь — 【защита】.", "Нажми Ⓓ, чтобы выполнить 【защиту】. Попробуй.", "Как правило, 【защита】 блокирует атаки, идущие спереди." ],
    "tutorial.dialog_3": [ "Хорошо! Теперь — 【прыжок】.", "Нажми Ⓙ, чтобы 【прыгнуть】. Попробуй.", "Можно также совмещать с направлением, чтобы 【прыгнуть】 в нужную сторону." ],
    "tutorial.dialog_4": [ "Хорошо! Теперь — 【бег】.", "В 【положении стоя】 дважды нажми '⬅/➡', чтобы 【побежать】.", "Затем можно нажать клавишу 'в противоположном направлении', чтобы остановиться.", "Попробуй." ],
    "tutorial.dialog_5": [ "Хорошо! Теперь — 【прыжок с разбега】.", "Во время 【бега】 нажми Ⓙ, чтобы выполнить 【прыжок с разбега】. Попробуй.", "", "(При 【приземлении после прыжка】 или 【перекате】, ", "нажатие '⬅/➡ + Прыжок' также позволяет выполнить 【прыжок с разбега】)" ],
    "tutorial.dialog_6": [ "Хорошо! Теперь — 【уклонение】.", "Во время 【бега】 нажми Ⓓ, чтобы 【уклониться】. Попробуй.", "", "(При 【приземлении после прыжка】 или 【перекате】, ", "нажатие Ⓓ также позволяет выполнить 【уклонение】)" ],
    "tutorial.dialog_7": [ "Одними уклонениями и защитой противника не одолеть. ", "Дальше ты изучишь разные способы атаки.", "Нажми Ⓐ, чтобы выполнить 【удар】." ],
    "tutorial.dialog_8": [ "Хорошо! Теперь — 【атака с разбега】.", "Во время 【бега】 нажми Ⓐ, чтобы выполнить 【атаку с разбега】.", "(Дважды нажми '⬅/➡', чтобы 【побежать】)" ],
    "tutorial.dialog_9": [ "Хорошо! Теперь — 【атака в прыжке】.", "Во время 【прыжка】 нажми Ⓐ, чтобы выполнить 【атаку в прыжке】.", "", "(Нажми Ⓙ, чтобы 【прыгнуть】)" ],
    "tutorial.dialog_10": [ "Хорошо! Теперь — 【атака в прыжке с разбега】.", "Во время 【прыжка с разбега】 нажми Ⓐ, чтобы выполнить 【атаку в прыжке с разбега】.", "", "(Дважды нажми '⬅/➡', чтобы 【побежать】, затем нажми Ⓙ, чтобы выполнить 【прыжок с разбега】)" ],
    "tutorial.dialog_11": [ "Хорошо! Но даже опытные бойцы вряд ли смогут полностью избежать урона. ", "Поэтому дальше ты изучишь: 【перекат】.", "Когда тебя 【подбросит в воздух】, нажми Ⓙ, чтобы выполнить 【перекат】.", "", "Сейчас я с помощью своей силы 【подброшу тебя в воздух】. Попробуй сделать 【перекат】." ],
    "tutorial.dialog_12": [ "Хорошо! Похоже, базовые приёмы ты уже знаешь!", "Однако использование 【спецприёмов】 сделает тебя в бою куда опаснее.", "", "Как правило, 【спецприёмы】 выполняются так: Ⓓ + ⬅/➡/⬆/⬇ + Ⓙ/Ⓐ.", "Лишь у очень немногих 【спецприёмов】 способ выполнения такой: Ⓓ + Ⓙ + Ⓐ.", "(Клавиши можно нажимать одновременно или по очереди.)" ],
    "tutorial.dialog_13": [ "Я вижу, что ты не обычный человек. \n", "Покажи мне свой 【спецприём】.\n", "( Пожалуйста, нажми Ⓓ + ➡ + Ⓐ )" ],
    "tutorial.dialog_14": [ "Так вот он, твой способ дальней атаки! Что ещё?", "", "( Пожалуйста, нажми Ⓓ + ➡ + Ⓙ )" ],
    "tutorial.dialog_15": [ "Весьма мощный боковой удар! Что ещё?", "", "( Пожалуйста, нажми Ⓓ + ⬆ + Ⓐ )" ],
    "tutorial.dialog_16": [ "Очень хорошо... Я изучил твои приёмы...", "…………" ],
    "tutorial.dialog_17": [ "Дальше путь за тебя пройду я. УМРИ!!" ],
