    KK: "ⒶⒿⒹ",
    "tutorial.key_hints": [ "Si aún no has configurado las teclas,", "haz clic en el botón de engranaje de la esquina superior derecha", " para ver y configurar las teclas." ],
    "tutorial.dialog_0": [ "¡Alto! Parece que no eres de por aquí...", "Antes de que todo comience, deberías familiarizarte con cómo se juega.", "De lo contrario, la situación en el combate será realmente mala." ],
    "tutorial.dialog_1": [ "Puedes mantener pulsadas las teclas 'Arriba/Abajo/Izquierda/Derecha', ", "y así podrás 【Caminar】 en una dirección concreta." ],
    "tutorial.dialog_2": [ "¡Bien! Lo siguiente es la 【Defensa】.", "Puedes pulsar Ⓓ para 【Defenderte】. Pruébalo.", "Por lo general, la 【Defensa】 puede bloquear los ataques frontales." ],
    "tutorial.dialog_3": [ "¡Bien! Lo siguiente es el 【Salto】.", "Puedes pulsar Ⓙ para 【Saltar】. Pruébalo.", "También puedes combinarlo con una dirección para 【Saltar】 hacia donde quieras." ],
    "tutorial.dialog_4": [ "¡Bien! Lo siguiente es la 【Carrera】.", "Cuando estés 【de pie】, haz doble clic en '⬅/➡' para empezar a 【Correr】.", "Luego, pulsa la 'dirección opuesta' para dejar de correr.", "Pruébalo." ],
    "tutorial.dialog_5": [ "¡Bien! Lo siguiente es el 【Salto en carrera】.", "Mientras estés en 【Carrera】, pulsa Ⓙ para hacer un 【Salto en carrera】. Pruébalo.", "", "(Al 【aterrizar de un salto】/al 【amortiguar la caída】, ", "pulsar '⬅/➡ + Salto' también permite hacer un 【Salto en carrera】)" ],
    "tutorial.dialog_6": [ "¡Bien! Lo siguiente es la 【Esquiva】.", "Mientras estés en 【Carrera】, pulsa Ⓓ para 【Esquivar】. Pruébalo.", "", "(Al 【aterrizar de un salto】/al 【amortiguar la caída】, ", "pulsar Ⓓ también permite hacer una 【Esquiva】)" ],
    "tutorial.dialog_7": [ "Esquivar y defender sin pensar no derrotará a tu adversario. ", "A continuación, aprenderás distintos métodos de ataque.", "Pulsa Ⓐ para dar un 【Puñetazo】." ],
    "tutorial.dialog_8": [ "¡Bien! Lo siguiente es el 【Ataque en carrera】.", "Mientras estés en 【Carrera】, pulsa Ⓐ para hacer un 【Ataque en carrera】.", "(Haz doble clic en '⬅/➡' para 【Correr】)" ],
    "tutorial.dialog_9": [ "¡Bien! Lo siguiente es el 【Ataque en salto】.", "Mientras estés en 【Salto】, pulsa Ⓐ para hacer un 【Ataque en salto】.", "", "(Pulsa Ⓙ para 【Saltar】)" ],
    "tutorial.dialog_10": [ "¡Bien! Lo siguiente es el 【Ataque en salto en carrera】.", "Mientras estés en pleno 【Salto en carrera】, pulsa Ⓐ para hacer un 【Ataque en salto en carrera】.", "", "(Haz doble clic en '⬅/➡' para 【Correr】 y luego pulsa Ⓙ para hacer un 【Salto en carrera】)" ],
    "tutorial.dialog_11": [ "¡Bien! Pero incluso los expertos difícilmente consiguen no salir heridos.", "Así que lo que aprenderás ahora es: 【amortiguar la caída】.", "Cuando te lancen 【por los aires】, pulsa Ⓙ para 【amortiguar la caída】.", "", "Ahora usaré mi poder para 【lanzarte por los aires】. Intenta 【amortiguar la caída】." ],
    "tutorial.dialog_12": [ "¡Bien! Parece que ya conoces algunas operaciones básicas.", "Sin embargo, usar 【Movimientos especiales】 te hará más eficaz en los combates.", "", "En general, la forma de lanzar un 【Movimiento especial】 es: Ⓓ + ⬅/➡/⬆/⬇ + Ⓙ/Ⓐ.", "Además, para muy pocos 【Movimientos especiales】, la forma de lanzarlos es: Ⓓ + Ⓙ + Ⓐ.", "(Puedes pulsarlos a la vez o uno tras otro.)" ],
    "tutorial.dialog_13": [ "Puedo notar que no eres una persona común. \n", "Muéstrame tus 【Movimientos especiales】.\n", "( Pulsa Ⓓ + ➡ + Ⓐ )" ],
    "tutorial.dialog_14": [ "¡Así que este es tu método de ataque a distancia! ¿Qué más tienes?", "", "( Pulsa Ⓓ + ➡ + Ⓙ )" ],
    "tutorial.dialog_15": [ "¡Una patada lateral muy poderosa! ¿Qué más tienes?", "", "( Pulsa Ⓓ + ⬆ + Ⓐ )" ],
    "tutorial.dialog_16": [ "Muy bien... he aprendido tus movimientos...", "…………" ],
    "tutorial.dialog_17": [ "El camino que tienes por delante, lo seguiré yo en tu lugar. ¡¡Muere!!" ],
