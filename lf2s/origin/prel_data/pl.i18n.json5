    KK: "ⒶⒿⒹ",
    "tutorial.key_hints": [ "Jeśli jeszcze nie ustawiłeś klawiszy,", "kliknij ikonę koła zębatego w prawym górnym rogu,", " aby zobaczyć i skonfigurować klawisze." ],
    "tutorial.dialog_0": [ "Stój! Chyba nie jesteś stąd...", "Zanim wszystko się zacznie, powinieneś poznać zasady gry.", "W przeciwnym razie w walce będzie naprawdę źle." ],
    "tutorial.dialog_1": [ "Możesz przytrzymać 'Góra/Dół/Lewo/Prawo', ", "a będziesz mógł 【Iść】 w wybranym kierunku." ],
    "tutorial.dialog_2": [ "Dobrze! Następnie: 【Obrona】.", "Naciśnij Ⓓ, aby się 【Bronić】. Spróbuj.", "Zazwyczaj 【Obrona】 może zablokować ataki z przodu." ],
    "tutorial.dialog_3": [ "Dobrze! Następnie: 【Skok】.", "Naciśnij Ⓙ, aby 【Skoczyć】. Spróbuj.", "Możesz też połączyć go z kierunkiem, aby 【Skoczyć】 w wybranym kierunku." ],
    "tutorial.dialog_4": [ "Dobrze! Następnie: 【Bieg】.", "Gdy 【stoisz】, kliknij dwukrotnie '⬅/➡', aby rozpocząć 【Bieg】.", "Potem naciśnij 'przeciwny kierunek', aby się zatrzymać.", "Spróbuj." ],
    "tutorial.dialog_5": [ "Dobrze! Następnie: 【Pęd】.", "Podczas 【Biegu】 naciśnij Ⓙ, aby wykonać 【Pęd】. Spróbuj.", "", "(【Lądując po skoku】/【Przewrót】, ", "naciśnięcie '⬅/➡ + Skok' również wykonuje 【Pęd】)" ],
    "tutorial.dialog_6": [ "Dobrze! Następnie: 【Unik】.", "Podczas 【Biegu】 naciśnij Ⓓ, aby 【Uniknąć】. Spróbuj.", "", "(【Lądując po skoku】/【Przewrót】, ", "naciśnięcie Ⓓ również wykonuje 【Unik】)" ],
    "tutorial.dialog_7": [ "Bezmyślne unikanie i bronienie nie pokona przeciwnika. ", "Teraz nauczysz się różnych metod ataku.", "Naciśnij Ⓐ, aby wykonać 【Cios】." ],
    "tutorial.dialog_8": [ "Dobrze! Następnie: 【Atak w biegu】.", "Podczas 【Biegu】 naciśnij Ⓐ, aby wykonać 【Atak w biegu】.", "(Kliknij dwukrotnie '⬅/➡', aby 【Biec】)" ],
    "tutorial.dialog_9": [ "Dobrze! Następnie: 【Atak z wyskoku】.", "Podczas 【Skoku】 naciśnij Ⓐ, aby wykonać 【Atak z wyskoku】.", "", "(Naciśnij Ⓙ, aby 【Skoczyć】)" ],
    "tutorial.dialog_10": [ "Dobrze! Następnie: 【Atak z pędu】.", "Podczas 【Pędu】 naciśnij Ⓐ, aby wykonać 【Atak z pędu】.", "", "(Kliknij dwukrotnie '⬅/➡', aby 【Biec】, potem naciśnij Ⓙ, aby 【Pędzić】)" ],
    "tutorial.dialog_11": [ "Dobrze! Ale nawet eksperci nie unikną całkowicie obrażeń.", "Teraz nauczysz się: 【Przewrót】.", "Gdy zostaniesz 【wyrzucony w powietrze】, naciśnij Ⓙ, aby wykonać 【Przewrót】.", "", "Teraz użyję mojej supermocy, aby 【wyrzucić cię w powietrze】. Spróbuj 【Przewrót】." ],
    "tutorial.dialog_12": [ "Dobrze! Wygląda na to, że znasz już podstawy!", "Jednak używanie 【Ruchów specjalnych】 uczyni cię lepszym w walce.", "", "Zazwyczaj 【Ruchy specjalne】 wykonuje się: Ⓓ + kierunek + Ⓙ/Ⓐ.", "Dla nielicznych 【Ruchów specjalnych】 sposób to: Ⓓ + Ⓙ + Ⓐ.", "(Możesz naciskać klawisze razem lub po kolei.)" ],
    "tutorial.dialog_13": [ "Widzę, że nie jesteś zwykłym człowiekiem. \n", "Pokaż mi swoje 【Ruchy specjalne】.\n", "( Naciśnij Ⓓ + ➡ + Ⓐ )" ],
    "tutorial.dialog_14": [ "Więc to jest twój sposób ataku z dystansu! Co jeszcze?", "", "( Naciśnij Ⓓ + ➡ + Ⓙ )" ],
    "tutorial.dialog_15": [ "Bardzo silne kopnięcie boczne! Co jeszcze?", "", "( Naciśnij Ⓓ + ⬆ + Ⓐ )" ],
    "tutorial.dialog_16": [ "Bardzo dobrze... nauczyłem się twoich ruchów...", "…………" ],
    "tutorial.dialog_17": [ "Przejmę ścieżkę przed tobą. GIŃ!!" ],
