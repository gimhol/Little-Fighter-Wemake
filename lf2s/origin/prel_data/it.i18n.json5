    "tutorial.key_hints": [ "Se non hai ancora configurato i tasti,", "fai clic sull'icona dell'ingranaggio in alto a destra", " per visualizzare e configurare i tasti." ],
    "tutorial.dialog_0": [ "Fermo! Non sembri del posto...", "Prima che tutto inizi, dovresti prendere confidenza con il gioco.", "Altrimenti in combattimento te la passerai davvero male." ],
    "tutorial.dialog_1": [ "Puoi tenere premuti 'Su/Giù/Sinistra/Destra' ", "e potrai 【Camminare】 in una direzione specifica." ],
    "tutorial.dialog_2": [ "Bene! Ora: 【Difesa】.", "Premi Ⓓ per 【Difenderti】. Prova.", "In genere la 【Difesa】 blocca gli attacchi frontali." ],
    "tutorial.dialog_3": [ "Bene! Ora: 【Salto】.", "Premi Ⓙ per 【Saltare】. Prova.", "Puoi anche combinarlo con una direzione per 【Saltare】 in una direzione specifica." ],
    "tutorial.dialog_4": [ "Bene! Ora: 【Corsa】.", "Quando sei 【in piedi】, fai doppio clic su '⬅/➡' per iniziare a 【Correre】.", "Poi premi la 'direzione opposta' per fermarti.", "Prova." ],
    "tutorial.dialog_5": [ "Bene! Ora: 【Scatto】.", "Durante la 【Corsa】, premi Ⓙ per eseguire uno 【Scatto】. Prova.", "", "(【Atterrando da un salto】/【Rotolata】, ", "premere '⬅/➡ + Salto' esegue anche uno 【Scatto】)" ],
    "tutorial.dialog_6": [ "Bene! Ora: 【Schivata】.", "Durante la 【Corsa】, premi Ⓓ per 【Schivare】. Prova.", "", "(【Atterrando da un salto】/【Rotolata】, ", "premere Ⓓ esegue anche una 【Schivata】)" ],
    "tutorial.dialog_7": [ "Schivare e difendersi alla cieca non sconfigge l'avversario. ", "Ora imparerai vari metodi d'attacco.", "Premi Ⓐ per eseguire un 【Pugno】." ],
    "tutorial.dialog_8": [ "Bene! Ora: 【Attacco in corsa】.", "Durante la 【Corsa】, premi Ⓐ per un 【Attacco in corsa】.", "(Fai doppio clic su '⬅/➡' per 【Correre】)" ],
    "tutorial.dialog_9": [ "Bene! Ora: 【Attacco saltando】.", "Durante il 【Salto】, premi Ⓐ per un 【Attacco saltando】.", "", "(Premi Ⓙ per 【Saltare】)" ],
    "tutorial.dialog_10": [ "Bene! Ora: 【Attacco in scatto】.", "Durante lo 【Scatto】, premi Ⓐ per un 【Attacco in scatto】.", "", "(Fai doppio clic su '⬅/➡' per 【Correre】, poi premi Ⓙ per 【Scattare】)" ],
    "tutorial.dialog_11": [ "Bene! Ma nemmeno gli esperti riescono a evitare del tutto i colpi.", "Quello che imparerai ora è: 【Rotolata】.", "Quando vieni 【scagliato in aria】, premi Ⓙ per una 【Rotolata】.", "", "Ora userò il mio superpotere per 【scagliarti in aria】. Prova la 【Rotolata】." ],
    "tutorial.dialog_12": [ "Bene! Sembra che tu conosca già le basi!", "Tuttavia, usare le 【Mosse speciali】 ti renderà più abile in combattimento.", "", "Di solito le 【Mosse speciali】 si eseguono con: Ⓓ + direzione + Ⓙ/Ⓐ.", "Per pochissime 【Mosse speciali】, il metodo è: Ⓓ + Ⓙ + Ⓐ.", "(Puoi premere i tasti insieme o uno alla volta.)" ],
    "tutorial.dialog_13": [ "Vedo che non sei una persona comune. \n", "Mostrami le tue 【Mosse speciali】.\n", "( Premi Ⓓ + ➡ + Ⓐ )" ],
    "tutorial.dialog_14": [ "Quindi questo è il tuo attacco a distanza! Cos'altro?", "", "( Premi Ⓓ + ➡ + Ⓙ )" ],
    "tutorial.dialog_15": [ "Calcio laterale molto potente! Cos'altro?", "", "( Premi Ⓓ + ⬆ + Ⓐ )" ],
    "tutorial.dialog_16": [ "Molto bene... ho imparato le tue mosse...", "…………" ],
    "tutorial.dialog_17": [ "Prenderò il posto davanti a te. MUORI!!" ],
