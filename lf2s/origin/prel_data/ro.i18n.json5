    KK: "ⒶⒿⒹ",
    "tutorial.key_hints": [ "Dacă nu ți-ai configurat încă tastele,", "apasă butonul cu rotiță din colțul din dreapta sus", " pentru a vedea și a configura tastele." ],
    "tutorial.dialog_0": [ "Stop! Nu pari a fi de prin părțile astea...", "Înainte de a începe totul, ar trebui să înveți cum să joci.", "Altfel, situația în luptă va fi foarte rea." ],
    "tutorial.dialog_1": [ "Poți ține apăsat 'Sus/Jos/Stânga/Dreapta', ", "și vei putea 【Merge】 într-o direcție anume." ],
    "tutorial.dialog_2": [ "Bine! Urmează 【Apărarea】.", "Apasă Ⓓ pentru 【Apărare】. Încearcă.", "În general, 【Apărarea】 poate bloca atacurile din față." ],
    "tutorial.dialog_3": [ "Bine! Urmează 【Săritura】.", "Apasă Ⓙ pentru 【Săritură】. Încearcă.", "Poți combina și cu o direcție pentru a 【Sări】 într-o direcție anume." ],
    "tutorial.dialog_4": [ "Bine! Urmează 【Alergarea】.", "Când ești 【în picioare】, dă dublu clic pe '⬅/➡' pentru a 【Alerga】.", "Apoi, apasă 'direcția opusă' pentru a te opri.", "Încearcă." ],
    "tutorial.dialog_5": [ "Bine! Urmează 【Sprintul】.", "În timp ce 【Alergi】, apasă Ⓙ pentru a face un 【Sprint】. Încearcă.", "", "(Când 【aterizezi după o săritură】/【faci rostogolirea la aterizare】, ", "apăsând '⬅/➡ + Săritură' poți face și un 【Sprint】)" ],
    "tutorial.dialog_6": [ "Bine! Urmează 【Esquiva】.", "În timp ce 【Alergi】, apasă Ⓓ pentru a face o 【Esquivă】. Încearcă.", "", "(Când 【aterizezi după o săritură】/【faci rostogolirea la aterizare】, ", "apăsând Ⓓ poți face și o 【Esquivă】)" ],
    "tutorial.dialog_7": [ "Dacă doar esquivezi și te aperi, nu-ți vei învinge adversarul. ", "Acum vei învăța diferite metode de atac.", "Apasă Ⓐ pentru a face un 【Pumn】." ],
    "tutorial.dialog_8": [ "Bine! Urmează 【Atacul din alergare】.", "În timp ce 【Alergi】, apasă Ⓐ pentru un 【Atac din alergare】.", "(Dă dublu clic pe '⬅/➡' pentru a 【Alerga】)" ],
    "tutorial.dialog_9": [ "Bine! Urmează 【Atacul din săritură】.", "În timp ce 【Sari】, apasă Ⓐ pentru un 【Atac din săritură】.", "", "(Apasă Ⓙ pentru 【Săritură】)" ],
    "tutorial.dialog_10": [ "Bine! Urmează 【Atacul din sprint】.", "În timp ce 【Sprintezi】, apasă Ⓐ pentru un 【Atac din sprint】.", "", "(Dă dublu clic pe '⬅/➡' pentru a 【Alerga】, apoi apasă Ⓙ pentru 【Sprint】)" ],
    "tutorial.dialog_11": [ "Bine! Dar nici experții nu reușesc să nu fie răniți deloc.", "Deci ce vei învăța acum este: 【Rostogolirea】.", "Când ești 【aruncat în aer】, apasă Ⓙ pentru a face o 【Rostogolire】.", "", "Acum îmi voi folosi puterea ca să te 【arunc în aer】. Încearcă să faci o 【Rostogolire】." ],
    "tutorial.dialog_12": [ "Bine! Se pare că știi deja operațiunile de bază!", "Totuși, folosind 【Mișcările speciale】 vei fi mai priceput în lupte.", "", "În general, modul de a scoate 【Mișcările speciale】 este: Ⓓ + direcție + Ⓙ/Ⓐ.", "De asemenea, pentru foarte puține 【Mișcări speciale】, metoda este: Ⓓ + Ⓙ + Ⓐ.", "(Poți apăsa tastele în același timp sau pe rând.)" ],
    "tutorial.dialog_13": [ "Îmi dau seama că nu ești un om obișnuit. \n", "Arată-mi 【Mișcările】 tale.\n", "( Te rog apasă Ⓓ + ➡ + Ⓐ )" ],
    "tutorial.dialog_14": [ "Deci acesta este atacul tău la distanță! Ce altceva?", "", "( Te rog apasă Ⓓ + ➡ + Ⓙ )" ],
    "tutorial.dialog_15": [ "Foarte puternică lovitura laterală! Ce altceva?", "", "( Te rog apasă Ⓓ + ⬆ + Ⓐ )" ],
    "tutorial.dialog_16": [ "Foarte bine... ți-am învățat mișcările...", "…………" ],
    "tutorial.dialog_17": [ "Drumul din fața ta îl voi lua eu. Mori!!" ],
