<?xml version="1.0" encoding="utf-8"?>
<directors id="weapons" name="Weapons &amp; Dropping">
  <director name="Baseball_1_1" bg="pixel_ruler">
    <actors>
      <actor id="weapon" oid="weapon_baseball" count="4">
        <layout type="line" axis="z" x="20" z="midZ" length="300" />
      </actor>
      <actor id="fighter" oid="mark,deep,davis,jan" count="4" group="fighters">
        <layout type="line" axis="z" x="20" z="midZ" length="300" />
      </actor>
    </actors>
    <timeline>
      <entry after="500">
        <input target="@fighters" click="a" />
      </entry>
      <entry after="500">
        <input target="@fighters">
          <step key_down="R" />
          <step click="a" />
        </input>
      </entry>
      <entry after="500">
        <input target="@fighters" key_up="R" />
        <camera dest="700,0" />
      </entry>
      <entry repeat="9999" interval="3000">
        <entry>
          <camera dest="600,0" />
        </entry>
        <entry>
          <camera dest="700,0" />
        </entry>
      </entry>
    </timeline>
  </director>
