  <director name="Dropped Weapon: No Hurt" bg="pixel_ruler">
    <actors>
      <actor id="a" oid="mark" x="midX" z="midZ">
        <values>
          <value name="name" type="str" value="A: 捡起石头(稍后被攻击)" />
          <value name="team" type="str" value="1" />
          <value name="facing" type="num" value="1" />
          <value name="stat_bar" type="num" value="0" />
          <value name="as_key_role" type="bool" value="true" />
        </values>
      </actor>
      <actor id="stone" oid="weapon_stone" x="midX - 8" z="midZ" />
      <actor id="c" oid="deep" x="midX - 150" z="midZ">
        <values>
          <value name="name" type="str" value="C: 被石头砸到(不应受伤)" />
          <value name="team" type="str" value="2" />
          <value name="facing" type="num" value="1" />
          <value name="stat_bar" type="num" value="0" />
          <value name="as_key_role" type="bool" value="true" />
        </values>
      </actor>
      <actor id="b" oid="davis" x="midX + 40" z="midZ">
        <values>
          <value name="name" type="str" value="B: 攻击A" />
          <value name="team" type="str" value="2" />
          <value name="facing" type="num" value="-1" />
          <value name="stat_bar" type="num" value="0" />
          <value name="as_key_role" type="bool" value="true" />
        </values>
      </actor>
    </actors>
    <groups>
      <group name="fighters" actors="a,b,c" />
    </groups>
    <timeline>
      <entry repeat="9999" interval="1000">
        <entry>
          <input target="a" click="a" />
        </entry>
        <entry>
          <place target="c" at="stone" dx="-8" dy="0" dz="0" requires="bearer" />
        </entry>
        <entry>
          <input target="b" click="a" />
        </entry>
        <entry />
        <entry />
        <entry>
          <reset />
        </entry>
      </entry>
    </timeline>
  </director>
