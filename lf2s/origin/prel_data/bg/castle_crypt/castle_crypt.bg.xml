  <layer color="#4b3f5e" width="2600" w="10" height="87" x="960" y="279" z="-1" />
  <layer color="#4b3f5e" width="2600" w="10" height="92" x="970" y="284" z="-1" />

  <!-- 斜坡 1520..1660（h 290 -> 200） -->
  <layer color="#4b3f5e" width="2600" w="10" height="92" x="1520" y="284" z="-1" />
  <layer color="#4b3f5e" width="2600" w="10" height="85" x="1530" y="277" z="-1" />
  <layer color="#4b3f5e" width="2600" w="10" height="79" x="1540" y="271" z="-1" />
  <layer color="#4b3f5e" width="2600" w="10" height="72" x="1550" y="264" z="-1" />
  <layer color="#4b3f5e" width="2600" w="10" height="66" x="1560" y="258" z="-1" />
  <layer color="#4b3f5e" width="2600" w="10" height="59" x="1570" y="251" z="-1" />
  <layer color="#4b3f5e" width="2600" w="10" height="53" x="1580" y="245" z="-1" />
  <layer color="#4b3f5e" width="2600" w="10" height="47" x="1590" y="239" z="-1" />
  <layer color="#4b3f5e" width="2600" w="10" height="40" x="1600" y="232" z="-1" />
  <layer color="#4b3f5e" width="2600" w="10" height="34" x="1610" y="226" z="-1" />
  <layer color="#4b3f5e" width="2600" w="10" height="27" x="1620" y="219" z="-1" />
