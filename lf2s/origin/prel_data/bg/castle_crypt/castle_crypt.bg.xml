  <layer color="#4b3f5e" width="2600" w="10" height="14" x="1640" y="206" z="-1" />
  <layer color="#4b3f5e" width="2600" w="10" height="8" x="1650" y="200" z="-1" />

  <!-- Boss 高台斜坡 2360..2460（h 200 -> 240） -->
  <layer color="#4b3f5e" width="2600" w="10" height="8" x="2360" y="200" z="-1" />
  <layer color="#4b3f5e" width="2600" w="10" height="12" x="2370" y="204" z="-1" />
  <layer color="#4b3f5e" width="2600" w="10" height="16" x="2380" y="208" z="-1" />
