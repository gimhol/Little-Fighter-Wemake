<background
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/gimhol/litter-fighter-2-WEMAKE/main/.vscode/schema/bg.xsd"
  id="castle_crypt">
  <!--
    示例地图：类恶魔城（Castlevania）风格，专门用来验证地形的 `one_way`（单向平台）。

    · 垂直：默认地面在 h=200（屏幕高 450，所以地面在屏幕 y=250 处，下方留出 200 的可见空间给坑）。
      base.height = 700（> 经典屏高 550），引擎会启用纵向相机：
        - 纵向可移动范围 = height - 屏高 = 250
        - 镜头 Y 跟随玩家平均高度（World 里 use_y 分支）
      站在大厅（200）时镜头贴底，爬到塔顶（455）时镜头上移。
    · Z 轴很窄：bound 的 far/near 只差 1（-1 ~ 0），行动纵深就 1。
      地形 z1/z2 铺 -5 ~ 4（9 宽 ≈ 阴影尺寸 shadowsize 37x9 的深度），
      这样平台在深度上足够承载阴影，但角色只能在这 1 宽的中心带里活动。
    · 布局（高度都是世界高度）：
        [0, 820)     入口大厅 200，三段浮空木台 260 / 315 / 370
        [820, 980)   上坡（斜坡，200 → 290）
        [980, 1180)  左侧回廊 290
        [1180, 1260) 裂缝：坑底 40，240 处一块单向木板可以踩着过
        [1260, 1520) 右侧回廊 290，上方 365 / 440 / 375 / 450 交错平台
        [1520, 1660) 下坡回大厅
        [1660, 2060) 大厅地面 200：270 / 330 / 395 / 455 的“塔”字单向平台
        [2060, 2260) 地牢坑（坑底 80），120 / 160 / 200 三块单向平台用来爬出来
        [2260, 2360) Boss 前厅 200
        [2360, 2600) Boss 房间：斜坡上到 240 的高台，310 处一块单向平台

    · 图层坐标（两个坑）：
      1) `y` 是该层**顶边**的世界高度（世界 Y 向上、y=0 在屏幕底边），图层从 y 向下铺 height：
         占满屏幕 → y=450, height=450；地形薄板（厚 T）→ y = 地形高度 h, height = T；
         斜坡 → 用 10px 一列的台阶，列顶 = 该列较低一侧的坡面高度。
      2) `width` 是**世界宽度**（算视差用）：parallax = (bg_width - width) * cam_x / (bg_width - screen_w)，
         要和地形 1:1 跟随必须 width = 2600（= bound 右边界），真正画多宽用 `w`。
         `absolute="1"` 的层不参与视差（整屏夜空）。
  -->
  <base
    name="Castle Crypt (one-way demo)"
    shadow="bg/sunken_shrine/s.png"
    shadowsize="37,9"
    bound="0,2600,-1,0"
    height="700"
    group="regular" />

  <dataset type="object">
    <value type="number" name="cam_y_follow" value="1" />
    <value type="number" name="gravity" value="0.365" />
    <value type="number" name="gravity_d" value="0.365" />
    <value type="number" name="jump_h_f" value="-0.54" />
    <value type="number" name="jump_hold_ctrl" value="0" />
    <value type="number" name="dash_h_f" value="-0.54" />
    <value type="number" name="air_ctrl" value="1" />
    <value type="number" name="air_ctrl_max_speed_x" value="6" />
  </dataset>

  <!-- ===== 入口大厅 ===== -->
  <terrain type="0" name="hall_ground" x1="0" x2="820" z1="-5" z2="4" h1="200" h2="200" />

  <!-- ===== 上坡到回廊 ===== -->
  <terrain type="1" name="slope_to_gallery" x1="820" x2="980" z1="-5" z2="4" h1="200" h2="290" />

  <!-- ===== 回廊 ===== -->
  <terrain type="0" name="gallery_left" x1="980" x2="1180" z1="-5" z2="4" h1="290" h2="290" />

  <!-- ===== 裂缝（掉下去到底下的坑） ===== -->
  <terrain type="0" name="chasm_floor" x1="1180" x2="1260" z1="-5" z2="4" h1="40" h2="40" />

  <!-- ===== 回廊（右） ===== -->
  <terrain type="0" name="gallery_right" x1="1260" x2="1520" z1="-5" z2="4" h1="290" h2="290" />

  <!-- ===== 下坡回大厅 ===== -->
  <terrain type="1" name="slope_to_hall" x1="1520" x2="1660" z1="-5" z2="4" h1="290" h2="200" />

  <!-- ===== 大厅地面（中间开一个深渊，走进去会坠崖） ===== -->
  <terrain type="0" name="hall_floor" x1="1660" x2="1900" z1="-5" z2="4" h1="200" h2="200" />
  <terrain type="0" name="abyss" x1="1900" x2="1980" z1="-5" z2="4" h1="-400" h2="-400" cliff="true" />
  <terrain type="0" name="hall_floor_2" x1="1980" x2="2060" z1="-5" z2="4" h1="200" h2="200" />

  <!-- ===== 地牢坑 ===== -->
  <terrain type="0" name="crypt_floor" x1="2060" x2="2260" z1="-5" z2="4" h1="80" h2="80" />

  <!-- ===== Boss 前厅 ===== -->
  <terrain type="0" name="boss_floor" x1="2260" x2="2360" z1="-5" z2="4" h1="200" h2="200" />

  <!-- ===== Boss 高台 ===== -->
  <terrain type="1" name="dais_slope" x1="2360" x2="2460" z1="-5" z2="4" h1="200" h2="240" />
  <terrain type="0" name="dais" x1="2460" x2="2600" z1="-5" z2="4" h1="240" h2="240" />

  <!-- ===== 单向平台（one_way）：四周不阻拦、可从下方穿过、可落到顶面 ===== -->
  <!-- 入口大厅的三段浮空木台 -->
  <terrain type="0" name="ow_hall_1" x1="300" x2="430" z1="-5" z2="4" h1="260" h2="260" through="true" />
  <terrain type="0" name="ow_hall_2" x1="470" x2="600" z1="-5" z2="4" h1="315" h2="315" through="true" />
  <terrain type="0" name="ow_hall_3" x1="640" x2="760" z1="-5" z2="4" h1="370" h2="370" through="true" />

  <!-- 回廊上方的交错木台 -->
  <terrain type="0" name="ow_gallery_1" x1="1010" x2="1120" z1="-5" z2="4" h1="365" h2="365" through="true" />
  <terrain type="0" name="ow_gallery_2" x1="1090" x2="1210" z1="-5" z2="4" h1="440" h2="440" through="true" />
  <terrain type="0" name="ow_gallery_3" x1="1250" x2="1370" z1="-5" z2="4" h1="375" h2="375" through="true" />
  <terrain type="0" name="ow_gallery_4" x1="1400" x2="1500" z1="-5" z2="4" h1="450" h2="450" through="true" />

  <!-- 裂缝上的桥：可以从下面跳穿上去，也可以落在上面走过去 -->
  <terrain type="0" name="ow_chasm_bridge" x1="1180" x2="1260" z1="-5" z2="4" h1="240" h2="240" through="true" />

  <!-- 大厅“塔”字平台 -->
  <terrain type="0" name="ow_tower_1" x1="1700" x2="1820" z1="-5" z2="4" h1="270" h2="270" through="true" />
  <terrain type="0" name="ow_tower_2" x1="1850" x2="1970" z1="-5" z2="4" h1="330" h2="330" through="true" />
  <terrain type="0" name="ow_tower_3" x1="1700" x2="1820" z1="-5" z2="4" h1="395" h2="395" through="true" />
  <terrain type="0" name="ow_tower_4" x1="1850" x2="1970" z1="-5" z2="4" h1="455" h2="455" through="true" />

  <!-- 地牢坑里的三段爬升木台 -->
  <terrain type="0" name="ow_crypt_1" x1="2070" x2="2140" z1="-5" z2="4" h1="120" h2="120" through="true" />
  <terrain type="0" name="ow_crypt_2" x1="2130" x2="2210" z1="-5" z2="4" h1="160" h2="160" through="true" />
  <terrain type="0" name="ow_crypt_3" x1="2190" x2="2260" z1="-5" z2="4" h1="200" h2="200" through="true" />

  <!-- Boss 房间高处 -->
  <terrain type="0" name="ow_boss_high" x1="2500" x2="2600" z1="-5" z2="4" h1="310" h2="310" through="true" />

  <!-- ===== 背景图层（width=2600 世界宽度 → 视差 0；w = 实际绘制宽度） ===== -->
  <!-- 夜空：绝对定位，占满屏幕 -->
  <layer color="#0b0813" width="1588" w="1588" height="450" x="0" y="450" z="-30" absolute="1" />
  <!-- 城堡后墙：world 空间 [0, 650] -->
  <layer color="#161022" width="2600" w="2600" height="650" x="0" y="650" z="-20" />
  <!-- 墙裙：从地面 0 起 350 高 -->
  <layer color="#1d1530" width="2600" w="2600" height="350" x="0" y="350" z="-14" />
  <!-- 高窗：世界高度 320 ~ 490 -->
  <layer color="#2b2040" width="2600" w="50" height="170" x="180" y="490" z="-10" />
  <layer color="#2b2040" width="2600" w="50" height="170" x="700" y="490" z="-10" />
  <layer color="#2b2040" width="2600" w="50" height="170" x="1220" y="490" z="-10" />
  <layer color="#2b2040" width="2600" w="50" height="170" x="1740" y="490" z="-10" />
  <layer color="#2b2040" width="2600" w="50" height="170" x="2260" y="490" z="-10" />
  <!-- 石柱：从地面 0 起 540 高 -->
  <layer color="#221a33" width="2600" w="30" height="540" x="120" y="540" z="-6" />
  <layer color="#221a33" width="2600" w="30" height="540" x="520" y="540" z="-6" />
  <layer color="#221a33" width="2600" w="30" height="540" x="900" y="540" z="-6" />
  <layer color="#221a33" width="2600" w="30" height="540" x="1300" y="540" z="-6" />
  <layer color="#221a33" width="2600" w="30" height="540" x="1680" y="540" z="-6" />
  <layer color="#221a33" width="2600" w="30" height="540" x="2080" y="540" z="-6" />
  <layer color="#221a33" width="2600" w="30" height="540" x="2420" y="540" z="-6" />

  <!-- ===== 地形本体（y = 地形高度，height = 厚度；板块在地形表面下方） ===== -->
  <!-- 平地：石板色 -->
  <layer color="#4b3f5e" width="2600" w="820" height="8" x="0" y="200" z="-1" />
  <layer color="#4b3f5e" width="2600" w="200" height="8" x="980" y="290" z="-1" />
  <layer color="#4b3f5e" width="2600" w="80" height="8" x="1180" y="40" z="-1" />
  <layer color="#4b3f5e" width="2600" w="260" height="8" x="1260" y="290" z="-1" />
  <layer color="#4b3f5e" width="2600" w="240" height="8" x="1660" y="200" z="-1" />
  <layer color="#4b3f5e" width="2600" w="80" height="8" x="1980" y="200" z="-1" />
  <layer color="#4b3f5e" width="2600" w="200" height="8" x="2060" y="80" z="-1" />
  <layer color="#4b3f5e" width="2600" w="100" height="8" x="2260" y="200" z="-1" />
  <layer color="#4b3f5e" width="2600" w="140" height="8" x="2460" y="240" z="-1" />

  <!-- 斜坡 820..980（h 200 -> 290）：10px 一列，列顶 = 该列较低一侧的坡面高度，只会在坡面下方 -->
  <layer color="#4b3f5e" width="2600" w="10" height="8" x="820" y="200" z="-1" />
