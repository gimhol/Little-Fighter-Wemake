  <layer color="#4b3f5e" width="2600" w="10" height="42" x="880" y="234" z="-1" />
  <layer color="#4b3f5e" width="2600" w="10" height="47" x="890" y="239" z="-1" />
  <layer color="#4b3f5e" width="2600" w="10" height="53" x="900" y="245" z="-1" />
  <layer color="#4b3f5e" width="2600" w="10" height="59" x="910" y="251" z="-1" />
  <layer color="#4b3f5e" width="2600" w="10" height="64" x="920" y="256" z="-1" />
