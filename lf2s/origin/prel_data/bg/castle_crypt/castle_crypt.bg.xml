  <layer color="#4b3f5e" width="2600" w="10" height="44" x="2450" y="236" z="-1" />

  <!-- 单向平台：木色薄板（y = 平台高度，height = 6） -->
  <layer color="#b08040" width="2600" w="130" height="6" x="300" y="260" z="-1" />
