<node id="network_rooms_page" name="页面：房间列表" local_only="true">
  <component cls="NetworkRoomsLogic"/>
  <component cls="NetworkSessionLogic"/>

  <node id="network_bg" pos="0,0,-450">
    <node ref="builtin_data/launch/bg.ui.json"/>
  </node>

  <node id="network_topbar" size="794,40" pos="0,0,1" clips="true">
    <node id="network_rooms_title" i18n="network.room_list" center="0,0.5" pos="16,20">
      <style font="bold 15px Arial" fill_style="#ffffff"/>
    </node>
    <node id="network_rooms_total" center="0,0.5" pos="108,20" opacity="0.55">
      <style font="12px Arial" fill_style="#ffffff"/>
    </node>
    <node id="network_account_chip_bg" size="82,18" center="0,0" pos="420,11" color="#00000040" visible="false">
      <node id="network_account_chip" center="0.5,0.5" pos="41,9">
        <style font="11px Arial" fill_style="#ffffff" text_align="center"/>
      </node>
    </node>
    <node id="network_btn_logout" i18n="network.logout" center="0.5,0.5" pos="430,20" visible="false">
      <style font="12px Arial" fill_style="#a8b9ff" text_align="center"/>
    </node>
    <node id="network_btn_create" i18n="network.create_room" center="0.5,0.5" pos="512,20">
      <style font="12px Arial" fill_style="#a8b9ff" text_align="center"/>
    </node>
    <node id="network_btn_refresh" i18n="network.refresh" center="0.5,0.5" pos="588,20">
      <style font="12px Arial" fill_style="#a8b9ff" text_align="center"/>
    </node>
    <node id="network_btn_auto" i18n="network.auto_refresh" center="0.5,0.5" pos="668,20">
      <style font="12px Arial" fill_style="#a8b9ff" text_align="center"/>
    </node>
    <node id="network_btn_disconnect" i18n="network.disconnect" center="0.5,0.5" pos="750,20">
      <style font="12px Arial" fill_style="#a8b9ff" text_align="center"/>
    </node>
  </node>

  <node id="network_rooms_panel" size="794,450" center="0,0" pos="0,0,1" clips="true">
    <node id="network_rooms_divider" size="762,1" center="0,0" pos="16,40" color="#ffffff29"/>
    <node id="network_room_rows" size="762,330" pos="16,48" clips="true">
      <node id="network_room_row" count="5" size="762,56" center="0,0" pos="0,0">
        <node id="network_room_name" center="0,0.5" pos="12,14">
          <style font="bold 15px Arial" fill_style="#ffffff"/>
        </node>
        <node id="network_room_code" center="0,0.5" pos="320,14">
          <style font="12px Consolas" fill_style="#9b9bff"/>
        </node>
        <node id="network_room_badge_bg" size="48,16" center="0,0" pos="466,6" color="#ffffff1f">
          <node id="network_room_badge" center="0.5,0.5" pos="24,8">
            <style font="11px Arial" fill_style="#ffffff" text_align="center"/>
          </node>
        </node>
        <node id="network_room_lock_bg" size="58,16" center="0,0" pos="526,6" color="#ffd08a26" visible="false">
          <node id="network_room_lock" i18n="network.password" center="0.5,0.5" pos="29,8">
            <style font="11px Arial" fill_style="#ffd08a" text_align="center"/>
          </node>
        </node>
        <node id="network_room_pwd_bg" size="84,20" center="0,0" pos="596,4" color="#0000007a" visible="false">
          <node id="network_room_pwd_input" size="84,20" center="0,0" pos="0,0">
            <component cls="TextInput">
              <properties>
                <number name="maxLength">32</number>
                <number name="fontSize">12</number>
                <string name="placeholder">••••</string>
              </properties>
            </component>
          </node>
        </node>
        <node id="network_room_join" i18n="network.join" center="0,0.5" pos="700,14">
          <style font="12px Arial" fill_style="#a8b9ff"/>
        </node>
        <node id="network_room_owner" center="0,0.5" pos="12,40" opacity="0.62">
          <style font="11px Arial" fill_style="#ffffff"/>
        </node>
        <node id="network_room_meta" center="0,0.5" pos="160,40" opacity="0.62">
          <style font="11px Arial" fill_style="#ffffff"/>
        </node>
        <node id="network_room_divider" size="762,1" center="0,0" pos="0,55" color="#ffffff14"/>
      </node>
    </node>
    <node id="network_rooms_divider_bottom" size="762,1" center="0,0" pos="16,384" color="#ffffff29"/>
    <node id="network_no_rooms" i18n="network.no_rooms" center="0.5,0.5" pos="397,200" opacity="0.6">
      <style font="13px Arial" fill_style="#ffffff" text_align="center"/>
    </node>
    <node id="network_rooms_status" center="0.5,0.5" pos="397,406">
      <style font="10px Arial" fill_style="#ff9b9b" text_align="center"/>
    </node>
    <node id="network_top_sub" center="1,0.5" pos="778,424" opacity="0.7">
      <style font="11px Arial" fill_style="#c9d4ff" text_align="right"/>
    </node>
    <node id="network_version" i18n="VERSION_NAME" center="0,0.5" pos="16,424" opacity="0.45">
      <style font="10px Arial" fill_style="#ffffff"/>
    </node>
    <node id="network_btn_prev" i18n="network.prev_page" center="0.5,0.5" pos="351,424">
      <style font="12px Arial" fill_style="#a8b9ff" text_align="center"/>
    </node>
    <node id="network_page_label" center="0.5,0.5" pos="397,424">
      <style font="12px Arial" fill_style="#ffffff" text_align="center"/>
    </node>
    <node id="network_btn_next" i18n="network.next_page" center="0.5,0.5" pos="443,424">
      <style font="12px Arial" fill_style="#a8b9ff" text_align="center"/>
    </node>
  </node>
</node>