{
  id: "settings_misc",
  name: "settings_misc",
  component: [
    "ReachableGroup(misc_settings,ud)",
    {
      cls: "MiscSettingsLogic",
    },
    {
      cls: "Flex",
      properties: {
        direction: "row",
        align: "center",
        gap: 5,
        padding: "0,0,0,0",
        fit: true,
      },
    },
  ],

  items: [
    {
      id: "settings_view",
      size: "700,323",
      component: [
        {
          cls: "ScrollView",
          properties: {
            direction: "col",
            content: "settings_list",
            scrollbar_thumb: "scroll_thumb",
            step: 41,
          },
        },
      ],
      items: [
        {
          id: "settings_list",
          component: [
            {
              cls: "Flex",
              properties: {
                direction: "column",
                align: "center",
                gap: 5,
                padding: "0,0,0,0",
                fit: true,
              },
            },
          ],
          items: [
        {
          id: "language_row",
          values: {
            prefix: "language",
            items: "lang.en,lang.zh-hans,lang.zh-hant,lang.de,lang.es,lang.fr,lang.it,lang.ja,lang.ko,lang.nl,lang.pl,lang.pt,lang.ru",
          },
          template: "ui/arrow_switcher_row.ui.json5",
        },
        {
          id: "main_volume_row",
          values: {
            prefix: "main_volume",
          },
          template: "ui/percentage_slider_row.ui.json5",
        },
        {
          id: "bgm_toggle_row",
          values: {
            prefix: "bgm",
            item0: "disable",
            item1: "enable",
            items: "disable,enable",
          },
          template: "ui/switcher_row.ui.json5",
        },
        {
          id: "bgm_volume_row",
          values: {
            prefix: "bgm_volume",
          },
          template: "ui/percentage_slider_row.ui.json5",
        },
        {
          id: "sfx_toggle_row",
          values: {
            prefix: "sfx",
            item0: "disable",
            item1: "enable",
            items: "disable,enable",
          },
          template: "ui/switcher_row.ui.json5",
        },
        {
          id: "sfx_volume_row",
          values: {
            prefix: "sfx_volume",
          },
          template: "ui/percentage_slider_row.ui.json5",
        },
        {
          id: "team_outline_row",
          values: {
            prefix: "team_outline",
            item0: "disable",
            item1: "enable",
            items: "disable,enable",
          },
          template: "ui/switcher_row.ui.json5",
        },
        {
          id: "ups_row",
          values: {
            prefix: "UPS",
            item0: "30 UPS",
            item1: "60 UPS",
            item2: "90 UPS",
            item3: "120 UPS",
            items: "30 UPS,60 UPS,90 UPS,120 UPS",
          },
          template: "ui/switcher_row.ui.json5",
        },
        {
          id: "render_rate_row",
          values: {
            prefix: "render_fps",
            item0: "sync_1",
            item1: "sync_2",
            item2: "sync_3",
            item3: "sync_4",
            item4: "sync_0",
            items: "sync_1,sync_2,sync_3,sync_4,sync_0",
          },
          template: "ui/switcher_row.ui.json5",
        },
        {
          id: "render_rate_row2",
          visible: false,
          values: {
            prefix: "render_fps",
            item0: "sync_1",
            item1: "sync_2",
            item2: "sync_3",
            item3: "sync_4",
            item4: "sync_0",
            items: "sync_1,sync_2,sync_3,sync_4,sync_0",
          },
          template: "ui/switcher_row.ui.json5",
        },
        {
          id: "render_rate_row3",
          visible: false,
          values: {
            prefix: "render_fps",
            item0: "sync_1",
            item1: "sync_2",
            item2: "sync_3",
            item3: "sync_4",
            item4: "sync_0",
            items: "sync_1,sync_2,sync_3,sync_4,sync_0",
          },
          template: "ui/switcher_row.ui.json5",
        },
      ],
        },
      ],
    },
    {
      id: "settings_scrollbar",
      size: "18,323",
      color: "#00000055",
      center: "0.5,0.5",
      items: [
        {
          id: "scroll_thumb",
          size: "18,287",
          color: "white",
          center: "0.5,0.5",
        },
      ],
    },
  ],
}
