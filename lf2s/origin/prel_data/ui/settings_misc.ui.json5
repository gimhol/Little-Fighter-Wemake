{
  id: "settings_misc",
  name: "settings_misc",
  flex: "display:flex; direction:row; align:center; gap:5; fit:true",
  component: [
    "ReachableGroup(misc_settings,ud)",
    {
      cls: "MiscSettingsLogic",
    },
  ],

  items: [
    {
      id: "settings_view",
      size: "700,323",
      component: [
        {
          cls: "ScrollView",
          properties: {
            direction: "col",
            content: "settings_list",
            scrollbar_thumb: "scroll_thumb",
            step: 41,
          },
        },
      ],
      items: [
        {
          id: "settings_list",
          flex: "display:flex; direction:column; align:center; gap:5; fit:true",
          items: [
        {
          id: "language_row",
          values: {
            prefix: "language",
            items: "lang.en,lang.zh-hans,lang.zh-hant,lang.de,lang.es,lang.fr,lang.hu,lang.it,lang.ja,lang.ko,lang.nl,lang.pl,lang.pt,lang.ro,lang.ru",
          },
          template: "ui/arrow_switcher_row.ui.json5",
        },
        {
          id: "main_volume_row",
          values: {
            prefix: "main_volume",
          },
          template: "ui/percentage_slider_row.ui.json5",
        },
        {
          id: "bgm_toggle_row",
          values: {
            prefix: "bgm",
            item0: "disable",
            item1: "enable",
            items: "disable,enable",
          },
          template: "ui/switcher_row.ui.json5",
        },
        {
          id: "bgm_volume_row",
          values: {
            prefix: "bgm_volume",
          },
          template: "ui/percentage_slider_row.ui.json5",
        },
        {
          id: "sfx_toggle_row",
          values: {
            prefix: "sfx",
            item0: "disable",
            item1: "enable",
            items: "disable,enable",
          },
          template: "ui/switcher_row.ui.json5",
        },
        {
          id: "sfx_volume_row",
          values: {
            prefix: "sfx_volume",
          },
          template: "ui/percentage_slider_row.ui.json5",
        },
        {
          id: "team_outline_row",
          values: {
            prefix: "team_outline",
            item0: "disable",
            item1: "enable",
            items: "disable,enable",
          },
          template: "ui/switcher_row.ui.json5",
        },
        {
          id: "ups_row",
          values: {
            prefix: "UPS",
            item0: "30 UPS",
            item1: "60 UPS",
            items: "30 UPS,60 UPS",
          },
          template: "ui/switcher_row.ui.json5",
        },
        {
          id: "ups_hint",
          i18n: "ups_hint",
          size: "700,22",
          center: "0.5,0.5",
          style: {
            font: "14px Arial",
            fill_style: "#ff6666",
          },
        },
        {
          id: "render_rate_row",
          values: {
            prefix: "render_fps",
            item0: "sync_1",
            item1: "sync_2",
            item2: "sync_3",
            item3: "sync_4",
            item4: "sync_0",
            items: "sync_1,sync_2,sync_3,sync_4,sync_0",
          },
          template: "ui/switcher_row.ui.json5",
        },
        {
          id: "render_fps_hint",
          i18n: "render_fps_hint",
          size: "700,38",
          center: "0.5,0.5",
          style: {
            font: "14px Arial",
            fill_style: "#ff6666",
          },
        },
        {
          // 选项顺序须与 Defines.RENDER_RESOLUTION_PRESETS 一致
          id: "render_resolution_row",
          values: {
            prefix: "render_resolution",
            items: "render_resolution_auto,794×450,1280×720,1588×900,1920×1080,2382×1350,3176×1800",
          },
          template: "ui/arrow_switcher_row.ui.json5",
        },
        {
          id: "render_rate_row2",
          visible: false,
          values: {
            prefix: "render_fps",
            item0: "sync_1",
            item1: "sync_2",
            item2: "sync_3",
            item3: "sync_4",
            item4: "sync_0",
            items: "sync_1,sync_2,sync_3,sync_4,sync_0",
          },
          template: "ui/switcher_row.ui.json5",
        },
        {
          id: "render_rate_row3",
          visible: false,
          values: {
            prefix: "render_fps",
            item0: "sync_1",
            item1: "sync_2",
            item2: "sync_3",
            item3: "sync_4",
            item4: "sync_0",
            items: "sync_1,sync_2,sync_3,sync_4,sync_0",
          },
          template: "ui/switcher_row.ui.json5",
        },
        {
          id: "stats_visible_row",
          values: {
            prefix: "stats_visible",
            item0: "disable",
            item1: "enable",
            items: "disable,enable",
          },
          template: "ui/switcher_row.ui.json5",
        },
      ],
        },
      ],
    },
    {
      id: "settings_scrollbar",
      size: "18,323",
      color: "#00000055",
      center: "0.5,0.5",
      items: [
        {
          id: "scroll_thumb",
          size: "18,287",
          color: "white",
          center: "0.5,0.5",
        },
      ],
    },
  ],
}
