<node id="network_modal" name="弹窗：联网游戏" local_only="true">
  <component cls="NetworkModalLogic"/>

  <node id="network_bg" pos="0,0,-450" alignment="left:left; right:right; top:top; bottom:bottom">
    <node ref="builtin_data/launch/bg.ui.json"/>
  </node>

  <node id="network_dim" size="794,450" center="0,0" pos="0,0" color="#00000040" alignment="left:left; right:right; top:top; bottom:bottom"/>

  <node id="__center" size="794,450" alignment="left:left; right:right; top:top; bottom:bottom" flex="display:flex; direction:row; justify:center; align:center">
  <node id="__design" size="794,450" center="0,0" flex="shrink:0">


  <node id="network_connect_panel" size="300,200" center="0,0" pos="267,100" clips="true">
    <node id="network_connect_frame_outer" size="300,200" center="0,0" pos="0,0" color="#5A73D6"/>
    <node id="network_connect_frame_mid" size="298,198" center="0,0" pos="1,1" color="#1F2F6F"/>
    <node id="network_connect_frame_fill" size="290,190" center="0,0" pos="5,5" color="#2F48A0"/>
    <node id="network_connect_title" i18n="network.title" center="0,0.5" pos="10,20">
      <style font="bold 17px Arial" fill_style="#ffffff"/>
    </node>
    <node id="network_connect_divider" size="384,1" center="0,0" pos="8,32" color="#ffffff29"/>
    <node id="network_guest_body">
      <node id="network_address_label" i18n="network.address" center="0,0.5" pos="10,43">
        <style font="12px Arial" fill_style="#9b9bff"/>
      </node>
      <node id="network_address_bg" size="280,24" center="0,0" pos="10,56" color="#0000007a">
        <node id="network_address_input" size="280,24" center="0,0" pos="0,0">
          <component cls="TextInput">
            <properties>
              <number name="maxLength">64</number>
              <number name="fontSize">14</number>
              <string name="defaultValue">lfj.gim.ink</string>
            </properties>
          </component>
        </node>
      </node>
      <node id="network_nickname_label" i18n="network.nickname" center="0,0.5" pos="10,94">
        <style font="12px Arial" fill_style="#9b9bff"/>
      </node>
      <node id="network_nickname_bg" size="280,24" center="0,0" pos="10,105" color="#0000007a">
        <node id="network_nickname_input" size="280,24" center="0,0" pos="0,0">
          <component cls="TextInput">
            <properties>
              <number name="maxLength">16</number>
              <number name="fontSize">14</number>
            </properties>
          </component>
        </node>
      </node>
      <node id="network_connect_action_divider" size="384,1" center="0,0" pos="8,166" color="#ffffff29"/>
      <node id="network_btn_connect" template="builtin_data/launch/menu_text_button.ui.json" center="0.5,0.5" pos="110,181">
        <values>
          <value name="text" type="string" value="network.btn_connect" />
        </values>
      </node>
      <node id="network_btn_connect_cancel" template="builtin_data/launch/menu_text_button.ui.json" center="0.5,0.5" pos="190,181">
        <values>
          <value name="text" type="string" value="network.btn_cancel" />
        </values>
      </node>
    </node>
    <node id="network_connect_status" center="0,0.5" pos="10,146">
      <style font="11px Arial" fill_style="#ff9b9b" text_align="center"/>
    </node>
  </node>

  <!-- 参考启动页右下角的加载动画，连接过程中显示 -->
  <node id="network_loading_anim" pos="760,428" visible="false">
    <node template="builtin_data/launch/loading_anim.ui.json"/>
  </node>

  </node>
  </node>
</node>
