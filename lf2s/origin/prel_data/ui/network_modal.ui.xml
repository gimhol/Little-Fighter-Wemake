<node id="network_modal" name="弹窗：联网游戏" local_only="true">
  <component cls="NetworkModalLogic"/>

  <node id="network_bg" pos="0,0,-450">
    <node ref="builtin_data/launch/bg.ui.json"/>
  </node>

  <node id="network_dim" size="794,450" center="0,0" pos="0,0,-400" color="#00000040"/>

  <node id="network_connect_panel" size="400,250" center="0,0" pos="197,100" clips="true">
    <node id="network_connect_frame_outer" size="400,250" center="0,0" pos="0,0" color="#5A73D6"/>
    <node id="network_connect_frame_mid" size="398,248" center="0,0" pos="1,1" color="#1F2F6F"/>
    <node id="network_connect_frame_fill" size="390,240" center="0,0" pos="5,5" color="#2F48A0"/>
    <node id="network_connect_title" i18n="network.title" center="0,0.5" pos="10,20">
      <style font="bold 17px Arial" fill_style="#ffffff"/>
    </node>
    <node id="network_connect_close" i18n="network.close" center="0.5,0.5" pos="356,20">
      <style font="12px Arial" fill_style="#a8b9ff" text_align="center"/>
    </node>
    <node id="network_connect_divider" size="384,1" center="0,0" pos="8,32" color="#ffffff29"/>

    <node id="network_tab_guest" i18n="network.guest" center="0,0" pos="16,37">
      <style font="15px Arial" fill_style="#ffffff" underline_color="#ffffff" underline_width="1"/>
    </node>
    <node id="network_tab_account" i18n="network.account" center="0,0" pos="86,37">
      <style font="15px Arial" fill_style="#a8b9ff"/>
    </node>

    <node id="network_guest_body">
      <node id="network_address_label" i18n="network.address" center="0,0.5" pos="14,108">
        <style font="12px Arial" fill_style="#9b9bff"/>
      </node>
      <node id="network_address_bg" size="300,24" center="0,0" pos="84,96" color="#0000007a">
        <node id="network_address_input" size="300,24" center="0,0" pos="0,0">
          <component cls="TextInput">
            <properties>
              <number name="maxLength">64</number>
              <number name="fontSize">14</number>
              <string name="defaultValue">lfj.gim.ink</string>
            </properties>
          </component>
        </node>
      </node>
      <node id="network_nickname_label" i18n="network.nickname" center="0,0.5" pos="14,144">
        <style font="12px Arial" fill_style="#9b9bff"/>
      </node>
      <node id="network_nickname_bg" size="300,24" center="0,0" pos="84,132" color="#0000007a">
        <node id="network_nickname_input" size="300,24" center="0,0" pos="0,0">
          <component cls="TextInput">
            <properties>
              <number name="maxLength">16</number>
              <number name="fontSize">14</number>
            </properties>
          </component>
        </node>
      </node>
      <node id="network_btn_connect" template="builtin_data/launch/menu_text_button.ui.json" center="0.5,0.5" pos="160,221">
        <values>
          <value name="text" type="string" value="network.connect" />
        </values>
      </node>
      <node id="network_btn_connect_cancel" template="builtin_data/launch/menu_text_button.ui.json" center="0.5,0.5" pos="240,221">
        <values>
          <value name="text" type="string" value="network.cancel" />
        </values>
      </node>
    </node>

    <node id="network_account_body" visible="false">
      <node id="network_account_address_label" i18n="network.address" center="0,0.5" pos="14,108">
        <style font="12px Arial" fill_style="#9b9bff"/>
      </node>
      <node id="network_account_address_bg" size="300,24" center="0,0" pos="84,96" color="#0000007a">
        <node id="network_account_address_input" size="300,24" center="0,0" pos="0,0">
          <component cls="TextInput">
            <properties>
              <number name="maxLength">64</number>
              <number name="fontSize">14</number>
              <string name="defaultValue">lfj.gim.ink</string>
            </properties>
          </component>
        </node>
      </node>

      <node id="network_account_out">
        <node id="network_account_out_note_1" i18n="network.account_note1" center="0.5,0.5" pos="200,136" opacity="0.6">
          <style font="11px Arial" fill_style="#ffffff" text_align="center"/>
        </node>
        <node id="network_account_out_note_2" i18n="network.account_note2" center="0.5,0.5" pos="200,152" opacity="0.6">
          <style font="11px Arial" fill_style="#ffffff" text_align="center"/>
        </node>
        <node id="network_btn_account_login" i18n="network.login_gim" center="0.5,0.5" pos="135,221">
          <style font="14px Arial" fill_style="#a8b9ff" text_align="center"/>
        </node>
        <node id="network_btn_account_cancel_0" i18n="network.cancel" center="0.5,0.5" pos="255,221">
          <style font="14px Arial" fill_style="#a8b9ff" text_align="center"/>
        </node>
      </node>

      <node id="network_account_pending" visible="false">
        <node id="network_account_pending_note_1" i18n="network.auth_pending1" center="0.5,0.5" pos="200,136" opacity="0.6">
          <style font="11px Arial" fill_style="#ffffff" text_align="center"/>
        </node>
        <node id="network_account_pending_note_2" i18n="network.auth_pending2" center="0.5,0.5" pos="200,152" opacity="0.6">
          <style font="11px Arial" fill_style="#ffffff" text_align="center"/>
        </node>
        <node id="network_btn_account_mock" i18n="network.mock_auth" center="0.5,0.5" pos="135,221">
          <style font="14px Arial" fill_style="#a8b9ff" text_align="center"/>
        </node>
        <node id="network_btn_account_cancel_1" i18n="network.cancel" center="0.5,0.5" pos="255,221">
          <style font="14px Arial" fill_style="#a8b9ff" text_align="center"/>
        </node>
      </node>

      <node id="network_account_in" visible="false">
        <node id="network_account_card_bg" size="372,42" center="0,0" pos="14,128" color="#00000038"/>
        <node id="network_account_avatar_bg" size="36,36" center="0,0" pos="20,131" color="#1F2F6F"/>
        <node id="network_account_avatar" i18n="G" center="0.5,0.5" pos="38,149">
          <style font="bold 20px Arial" fill_style="#ffffff" text_align="center"/>
        </node>
        <node id="network_account_name" center="0,0.5" pos="68,136">
          <style font="bold 15px Arial" fill_style="#ffffff"/>
        </node>
        <node id="network_account_id" center="0,0.5" pos="68,158" opacity="0.55">
          <style font="11px Arial" fill_style="#ffffff"/>
        </node>
        <node id="network_account_provider" i18n="gim.ink" center="0,0.5" pos="330,136">
          <style font="12px Arial" fill_style="#8FA6E8"/>
        </node>
        <node id="network_account_scope" i18n="network.auth_scope" center="0,0.5" pos="14,180" opacity="0.6">
          <style font="11px Arial" fill_style="#ffffff"/>
        </node>
        <node id="network_btn_account_enter" i18n="network.enter_lobby" center="0.5,0.5" pos="135,221">
          <style font="14px Arial" fill_style="#a8b9ff" text_align="center"/>
        </node>
        <node id="network_btn_account_logout" i18n="network.logout" center="0.5,0.5" pos="255,221">
          <style font="14px Arial" fill_style="#ff9b9b" text_align="center"/>
        </node>
      </node>
    </node>

    <node id="network_connect_status" center="0.5,0.5" pos="200,186">
      <style font="11px Arial" fill_style="#ff9b9b" text_align="center"/>
    </node>
    <node id="network_connect_action_divider" size="384,1" center="0,0" pos="8,196" color="#ffffff29"/>
  </node>


</node>