{
  "": {
    "init.tap_any_place_to_launch": "CLICK ANYWHERE TO CONTINUE",
    "init.sound_warning": "WARNING：After starting, the sound and background music will play. \nClick the speaker icon in the upper-right corner to turn off the sound. \nClick the musical note icon in the upper-right corner to turn off the background music.",
    "init.long_description": 'Gameplays, Arts, Sounds, Music are all from "Litter Fighter 2" basically.\ncreated by Marti Wong and Starsky Wong in 1999.\n\n"Little Fighter Wemake" created by Gim in 2024.',
    extra_data: "Mods",
    add_mods: "Add Mods",
  },
  "zh-hans": {
    "init.tap_any_place_to_launch": "点击任意位置继续",
    "init.sound_warning": "警告：开始后将播放声音，点击右上方喇叭关闭声音\n将播放背景音乐，点击右上方音符关闭背景音乐",
    "init.long_description": '大部分玩法、美术、音效音乐来自 "Litter Fighter 2" \n原作：Marti Wong，Starsky Wong.\n\n"Little Fighter Wemake" created by Gim in 2024.',
    extra_data: "附 加 模 组",
    add_mods: "附 加 模 组",
  },
  "zh-hant": {
    "init.tap_any_place_to_launch": "點擊任何位置繼續",
    "init.sound_warning": "警告：開始後將播放聲音，點擊右上方喇叭關閉聲音\n將播放背景音樂，點擊右上方音符關閉背景音樂",
    "init.long_description": '大部分玩法、美術、音效音樂來自 "Litter Fighter 2" \n原作：Marti Wong，Starsky Wong.\n\n"Little Fighter Wemake" created by Gim in 2024.',
    extra_data: "附 加 模 組",
    add_mods: "附 加 模 组",
  },
  fr: {
    "init.tap_any_place_to_launch": "CLIQUEZ N'IMPORTE OÙ POUR CONTINUER",
    "init.sound_warning": "ATTENTION : après le démarrage, le son et la musique de fond seront joués. \nCliquez sur l'icône du haut-parleur en haut à droite pour couper le son. \nCliquez sur l'icône de note de musique en haut à droite pour couper la musique de fond.",
    "init.long_description": "La plupart des mécanismes de jeu, des graphismes, des sons et de la musique proviennent de \"Little Fighter 2\".\nCréé par Marti Wong et Starsky Wong en 1999.\n\n\"Little Fighter Wemake\" créé par Gim en 2024.\n\nTraduit par Deepseek v4 flash, non relu, veuillez excuser les éventuelles erreurs.",
    extra_data: "Mods",
    add_mods: "Ajouter des mods",
  },
  es: {
    "init.tap_any_place_to_launch": "HAZ CLIC EN CUALQUIER LUGAR PARA CONTINUAR",
    "init.sound_warning": "ADVERTENCIA: después de comenzar, se reproducirán el sonido y la música de fondo. \nHaz clic en el icono del altavoz en la esquina superior derecha para silenciar el sonido. \nHaz clic en el icono de la nota musical en la esquina superior derecha para silenciar la música de fondo.",
    "init.long_description": "La mayoría de las mecánicas de juego, los gráficos, los sonidos y la música provienen de \"Little Fighter 2\".\nCreado por Marti Wong y Starsky Wong en 1999.\n\n\"Little Fighter Wemake\" creado por Gim en 2024.\n\nTraducido por Deepseek v4 flash, sin revisar, disculpa cualquier error.",
    extra_data: "Mods",
    add_mods: "Añadir mods",
  },
  pt: {
    "init.tap_any_place_to_launch": "CLIQUE EM QUALQUER LUGAR PARA CONTINUAR",
    "init.sound_warning": "AVISO: após iniciar, o som e a música de fundo serão reproduzidos. \nClique no ícone do alto-falante no canto superior direito para desativar o som. \nClique no ícone de nota musical no canto superior direito para desativar a música de fundo.",
    "init.long_description": "A maioria das mecânicas de jogo, artes, sons e músicas provêm de \"Little Fighter 2\".\nCriado por Marti Wong e Starsky Wong em 1999.\n\n\"Little Fighter Wemake\" criado por Gim em 2024.\n\nTraduzido por Deepseek v4 flash, não revisado, desculpe qualquer erro.",
    extra_data: "Mods",
    add_mods: "Adicionar mods",
  },
  ja: {
    "init.tap_any_place_to_launch": "どこでもクリックして続行",
    "init.sound_warning": "警告：開始すると効果音とBGMが再生されます。\n右上のスピーカーアイコンをクリックすると効果音をオフにできます。\n右上の音符アイコンをクリックするとBGMをオフにできます。",
    "init.long_description": "ゲームのシステム、グラフィック、効果音、音楽のほとんどは \"Little Fighter 2\" に由来しています。\n1999年にMarti WongとStarsky Wongによって制作されました。\n\n\"Little Fighter Wemake\" は2024年にGimによって制作されました。\n\nDeepseek v4 flash による翻訳、未校正です。誤りがありましたらご容赦ください。",
    extra_data: "MOD",
    add_mods: "MODを追加",
  },
  ko: {
    "init.tap_any_place_to_launch": "아무 곳이나 클릭하여 계속",
    "init.sound_warning": "경고: 시작하면 효과음과 배경 음악이 재생됩니다. \n오른쪽 위 스피커 아이콘을 클릭하면 효과음을 끌 수 있습니다. \n오른쪽 위 음표 아이콘을 클릭하면 배경 음악을 끌 수 있습니다.",
    "init.long_description": "게임의 시스템, 그래픽, 효과음, 음악의 대부분은 \"Little Fighter 2\"에서 비롯되었습니다.\n1999년 Marti Wong과 Starsky Wong이 제작했습니다.\n\n\"Little Fighter Wemake\"는 2024년 Gim이 제작했습니다.\n\nDeepseek v4 flash 번역, 미검수입니다. 오류가 있다면 양해 부탁드립니다.",
    extra_data: "모드",
    add_mods: "모드 추가",
  },
  ru: {
    "init.tap_any_place_to_launch": "НАЖМИТЕ В ЛЮБОМ МЕСТЕ, ЧТОБЫ ПРОДОЛЖИТЬ",
    "init.sound_warning": "ВНИМАНИЕ: после запуска будут воспроизводиться звук и фоновая музыка. \nНажмите на значок динамика в правом верхнем углу, чтобы отключить звук. \nНажмите на значок ноты в правом верхнем углу, чтобы отключить фоновую музыку.",
    "init.long_description": "Большинство игровых механик, графика, звуки и музыка взяты из \"Little Fighter 2\".\nСоздано Марти Вонгом и Старски Вонгом в 1999 году.\n\n\"Little Fighter Wemake\" создан Гимом в 2024 году.\n\nПереведено Deepseek v4 flash, не проверено, простите за возможные ошибки.",
    extra_data: "Моды",
    add_mods: "Добавить моды",
  },
  nl: {
    "init.tap_any_place_to_launch": "KLIK OVERAL OM DOOR TE GAAN",
    "init.sound_warning": "WAARSCHUWING: na het starten worden het geluid en de achtergrondmuziek afgespeeld. \nKlik op het luidsprekerpictogram rechtsboven om het geluid uit te zetten. \nKlik op het muzieknootpictogram rechtsboven om de achtergrondmuziek uit te zetten.",
    "init.long_description": "De meeste spelmechanismen, graphics, geluiden en muziek komen van \"Little Fighter 2\".\nGemaakt door Marti Wong en Starsky Wong in 1999.\n\n\"Little Fighter Wemake\" gemaakt door Gim in 2024.\n\nVertaald door Deepseek v4 flash, niet nagelezen, excuses voor eventuele fouten.",
    extra_data: "Mods",
    add_mods: "Mods toevoegen",
  },
  de: {
    "init.tap_any_place_to_launch": "ZUM FORTSETZEN IRGENDWO HIN KLICKEN",
    "init.sound_warning": "WARNUNG: Nach dem Start werden Sound und Hintergrundmusik abgespielt. \nKlicken Sie oben rechts auf das Lautsprechersymbol, um den Sound auszuschalten. \nKlicken Sie oben rechts auf das Notensymbol, um die Hintergrundmusik auszuschalten.",
    "init.long_description": "Die meisten Spielmechaniken, Grafiken, Sounds und Musik stammen aus \"Little Fighter 2\".\nErstellt von Marti Wong und Starsky Wong im Jahr 1999.\n\n\"Little Fighter Wemake\" erstellt von Gim im Jahr 2024.\n\nÜbersetzt von Deepseek v4 flash, nicht korrekturgelesen, bitte entschuldigen Sie etwaige Fehler.",
    extra_data: "Mods",
    add_mods: "Mods hinzufügen",
  },
  pl: {
    "init.tap_any_place_to_launch": "KLIKNIJ GDZIEKOLWIEK, ABY KONTYNUOWAĆ",
    "init.sound_warning": "OSTRZEŻENIE: po uruchomieniu odtwarzany będzie dźwięk i muzyka w tle. \nKliknij ikonę głośnika w prawym górnym rogu, aby wyciszyć dźwięk. \nKliknij ikonę nuty w prawym górnym rogu, aby wyciszyć muzykę w tle.",
    "init.long_description": "Większość mechanik gry, grafiki, dźwięków i muzyki pochodzi z \"Little Fighter 2\".\nStworzone przez Marti Wonga i Starsky Wonga w 1999 roku.\n\n\"Little Fighter Wemake\" stworzone przez Gima w 2024 roku.\n\nPrzetłumaczone przez Deepseek v4 flash, niesprawdzone, przepraszamy za ewentualne błędy.",
    extra_data: "Mody",
    add_mods: "Dodaj mody",
  },
  it: {
    "init.tap_any_place_to_launch": "FARE CLIC IN UN PUNTO QUALSIASI PER CONTINUARE",
    "init.sound_warning": "ATTENZIONE: dopo l'avvio verranno riprodotti l'audio e la musica di sottofondo. \nFai clic sull'icona dell'altoparlante in alto a destra per disattivare l'audio. \nFai clic sull'icona della nota musicale in alto a destra per disattivare la musica di sottofondo.",
    "init.long_description": "La maggior parte delle meccaniche di gioco, delle grafiche, dei suoni e della musica provengono da \"Little Fighter 2\".\nCreato da Marti Wong e Starsky Wong nel 1999.\n\n\"Little Fighter Wemake\" creato da Gim nel 2024.\n\nTradotto da Deepseek v4 flash, non rivisto, scusate per eventuali errori.",
    extra_data: "Mod",
    add_mods: "Aggiungi mod",
  },
