{
  "name": "little-fighter-wemake",
  "version": "0.1.56",
  "type": "module",
  "private": true,
  "homepage": ".",
  "author": {
    "name": "Gim"
  },
  "scripts": {
    "dev": "vite",
    "start": "vite --profile",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "jest",
    "___build___": "___build___",
    "build:tool": "cd ./tool && npm i && npm run build",
    "build:data": "node ./tool make-data-zip -c ./lf2s/origin/conf.json5 -d",
    "build:prel": "node ./tool make-prel -c ./lf2s/origin/conf.json5 -d",
    "build:tool:data": "npm run build:tool && npm run build:data",
    "build:tool:prel": "npm run build:tool && npm run build:prel",
    "zip": "node ./tool zip-full -c ./lf2s/origin/conf.json5 -d",
    "txt": "node ./tool dat-2-txt -c ./lf2s/origin/conf.json5 -d",
    "build:data:rn": "node ./tool make-data-zip -c ./lf2s/rn/conf.json5 -d",
    "build:prel:rn": "node ./tool make-prel -c ./lf2s/rn/conf.json5 -d",
    "build:tool:data:rn": "npm run build:tool && npm run build:data:rn",
    "build:tool:prel:rn": "npm run build:tool && npm run build:prel:rn",
    "pick:rn": "npm run build:tool && node ./tool make-data -c ./lf2s/rn/conf.json5 -d && node ./tool pick -c ./lf2s/rn/pick-conf.json5 -d",
    "txt:rn": "node ./tool dat-2-txt -c ./lf2s/rn/conf.json5 -d",
    "___deploy___": "___deploy___",
    "deploy": "node scripts/deploy-web.mjs",
    "deploy:dry": "node scripts/deploy-web.mjs --dry",
    "deploy:rn": "node scripts/deploy-web.mjs --prefix rn",
    "deploy:latest": "node scripts/deploy-latest.mjs",
    "deploy:docs": "fdeploy -s oss --REMOTE_DIR docs --LOCAL_PATH docs",
    "deploy:demo": "fdeploy -s oss --REMOTE_DIR demo --LOCAL_PATH ./dist",
    "___flow___": "___flow___",
    "flow": "npm run build && npm run deploy && npm run deploy:latest",
    "flow:rn": "npm run build && npm run deploy:rn",
    "changelog": "node scripts/merge-changelog.mjs",
    "build:ext": "node scripts/build-extension.mjs",
    "build:ext:zip": "node scripts/build-extension.mjs --zip",
    "pack:ext": "node scripts/package-extension.mjs",
    "pack:ext:crx": "node scripts/package-extension.mjs --crx",
    "pack:ext:key": "node scripts/package-extension.mjs --key-gen",
    "build:ext:firefox": "node scripts/package-extension-firefox.mjs",
    "build:ext:firefox:only": "node scripts/package-extension-firefox.mjs --no-build",
    "build:blbl": "tsc -b && vite build --mode bili-toy && node scripts/build-blbl-toy.mjs --dir dist-toy",
    "build:playable": "node scripts/build-bili-playable.mjs",
    "build:desktop": "node scripts/build-bili-playable.mjs",
    "dev:blbl": "vite --mode bili-toy",
    "__ELECTRON_INSTALLER__": "__ELECTRON_INSTALLER__",
    "build:installer": "node scripts/build-installer.mjs",
    "deploy:installer": "node scripts/deploy-installer.mjs",
    "flow:installer": "npm run build && node ./scripts/build-installer.mjs --no-build && npm run deploy:installer",
    "__OTHERS___": "__OTHERS___",
    "rn:pull": "node ./scripts/zipsync.mjs pull --url https://lf.gim.ink/convertings/rn.zip --dir ./lf2s/rn --zip ./lf2s/rn.zip",
    "rn:push": "node ./scripts/zipsync.mjs push --url https://lf.gim.ink/convertings/rn.zip --dir ./lf2s/rn --zip ./lf2s/rn.zip",
    "public:pull": "node ./scripts/zipsync.mjs pull --url https://lf.gim.ink/convertings/public.zip --dir ./public --zip ./lf2s/public.zip",
    "public:push": "node ./scripts/zipsync.mjs push --url https://lf.gim.ink/convertings/public.zip --dir ./public --zip ./lf2s/public.zip",
    "exports:lf2": "node ./scripts/auto-exports.mjs ./src/LFW",
    "exports:ditto": "node ./scripts/auto-exports.mjs ./src/DittoImpl",
    "register:components": "node ./scripts/auto-components.mjs",
    "auto": "npm run exports:lf2 && npm run exports:ditto && npm run register:components"
  },
  "dependencies": {
    "@fimagine/logger": "^1.2.1",
    "@fimagine/writeboard": "^0.2.0",
    "@fingerprintjs/fingerprintjs": "^5.2.0",
    "axios": "^1.10.0",
    "compressing": "^2.0.0",
    "current-device": "0.10.2",
    "dexie": "^4.3.0",
    "fflate": "0.8.3",
    "i18next": "^25.7.4",
    "json5": "^2.2.3",
    "jszip": "3.10.1",
    "localforage": "^1.10.0",
    "promise-in-one": "^1.0.0",
    "qs": "^6.14.0",
    "rc-virtual-list": "^3.19.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-i18next": "^16.5.2",
    "react-router": "7.9.6",
    "react-router-dom": "7.9.6",
    "spark-md5": "3.0.2",
    "splittings": "^1.2.0",
    "splittings-dom": "^1.2.1",
    "three": "^0.181.2",
    "use-immer": "^0.11.0",
    "xml-formatter": "^3.7.0"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@fimagine/frontend_deployer": "^1.1.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.13",
    "@types/qs": "^6.14.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/spark-md5": "^3.0.5",
    "@types/three": "^0.181.0",
    "@vitejs/plugin-react": "^5.1.1",
    "baseline-browser-mapping": "^2.10.0",
    "classnames": "^2.5.1",
    "dayjs": "^1.11.20",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "electron-updater": "^6.8.9",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "jest": "^30.2.0",
    "sass-embedded": "^1.93.3",
    "ts-jest": "^29.4.6",
    "ts-json-schema-generator": "^2.4.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.2.4",
    "vite-plugin-checker": "^0.14.4",
    "vite-plugin-devtools-json": "^1.0.0",
    "vite-plugin-glsl": "^1.5.6",
    "vite-plugin-html": "^3.2.2",
    "ws": "^8.21.3"
  },
  "allowScripts": {
    "electron@44.4.3": true,
    "@electron/packager@20.3.0": true
  }
}
