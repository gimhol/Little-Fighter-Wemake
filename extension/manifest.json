{
  "manifest_version": 3,
  "name": "Legacy Flame War: Web",
  "version": "0.1.63",
  "description": "Legacy Flame War: Web",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png",
    "256": "icon256.png"
  },
  "action": {
    "default_title": "Legacy Flame War: Web",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png",
      "256": "icon256.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; connect-src 'self' data: blob:"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "little-fighter-wemake@example.com",
      "strict_min_version": "115.0"
    }
  }
}
